<erp>
  <data noupdate="1">
    <record id="report_tax_report" model="reporting.report">
      <field name="name">Tax Report</field>
      <field name="multi_company" eval="False"/>
      <field name="totals_below" eval="True"/>
    </record>
    <record id="tax_report_col_debit" model="reporting.report.column">
      <field name="report_id" ref="report_tax_report"/>
      <field name="sequence">10</field>
      <field name="name">Debit</field>
      <field name="label">debit</field>
      <field name="kind">monetary</field>
    </record>
    <record id="tax_report_col_credit" model="reporting.report.column">
      <field name="report_id" ref="report_tax_report"/>
      <field name="sequence">20</field>
      <field name="name">Credit</field>
      <field name="label">credit</field>
      <field name="kind">monetary</field>
    </record>
    <record id="tax_report_col_tax" model="reporting.report.column">
      <field name="report_id" ref="report_tax_report"/>
      <field name="sequence">30</field>
      <field name="name">Net Tax</field>
      <field name="label">tax</field>
      <field name="kind">monetary</field>
    </record>
    <record id="tax_report_sales" model="reporting.report.line">
      <field name="report_id" ref="report_tax_report"/>
      <field name="sequence">10</field>
      <field name="name">Sales Taxes</field>
      <field name="code">SALES_TAX</field>
      <field name="groupby">tax_line_id,account_id</field>
    </record>
    <record id="tax_report_sales_debit" model="reporting.report.expression">
      <field name="line_id" ref="tax_report_sales"/>
      <field name="label">debit</field>
      <field name="model">account.move.line</field>
      <field name="field">debit</field>
      <field name="date_field">date</field>
      <field name="date_scope">strict_range</field>
      <field name="domain">[["parent_state","=","posted"],["tax_line_id","!=",false],["tax_line_id.type_tax_use","=","sale"]]</field>
    </record>
    <record id="tax_report_sales_credit" model="reporting.report.expression">
      <field name="line_id" ref="tax_report_sales"/>
      <field name="label">credit</field>
      <field name="model">account.move.line</field>
      <field name="field">credit</field>
      <field name="date_field">date</field>
      <field name="date_scope">strict_range</field>
      <field name="domain">[["parent_state","=","posted"],["tax_line_id","!=",false],["tax_line_id.type_tax_use","=","sale"]]</field>
    </record>
    <record id="tax_report_sales_booked" model="reporting.report.expression">
      <field name="line_id" ref="tax_report_sales"/>
      <field name="label">booked</field>
      <field name="model">account.move.line</field>
      <field name="field">balance</field>
      <field name="date_field">date</field>
      <field name="date_scope">strict_range</field>
      <field name="domain">[["parent_state","=","posted"],["tax_line_id","!=",false],["tax_line_id.type_tax_use","=","sale"]]</field>
    </record>
    <record id="tax_report_sales_tax" model="reporting.report.expression">
      <field name="line_id" ref="tax_report_sales"/>
      <field name="label">tax</field>
      <field name="engine">formula</field>
      <field name="formula">0 - booked</field>
    </record>
    <record id="tax_report_purchase" model="reporting.report.line">
      <field name="report_id" ref="report_tax_report"/>
      <field name="sequence">20</field>
      <field name="name">Purchase Taxes</field>
      <field name="code">PURCHASE_TAX</field>
      <field name="groupby">tax_line_id,account_id</field>
    </record>
    <record id="tax_report_purchase_debit" model="reporting.report.expression">
      <field name="line_id" ref="tax_report_purchase"/>
      <field name="label">debit</field>
      <field name="model">account.move.line</field>
      <field name="field">debit</field>
      <field name="date_field">date</field>
      <field name="date_scope">strict_range</field>
      <field name="domain">[["parent_state","=","posted"],["tax_line_id","!=",false],["tax_line_id.type_tax_use","=","purchase"]]</field>
    </record>
    <record id="tax_report_purchase_credit" model="reporting.report.expression">
      <field name="line_id" ref="tax_report_purchase"/>
      <field name="label">credit</field>
      <field name="model">account.move.line</field>
      <field name="field">credit</field>
      <field name="date_field">date</field>
      <field name="date_scope">strict_range</field>
      <field name="domain">[["parent_state","=","posted"],["tax_line_id","!=",false],["tax_line_id.type_tax_use","=","purchase"]]</field>
    </record>
    <record id="tax_report_purchase_tax" model="reporting.report.expression">
      <field name="line_id" ref="tax_report_purchase"/>
      <field name="label">tax</field>
      <field name="model">account.move.line</field>
      <field name="field">balance</field>
      <field name="date_field">date</field>
      <field name="date_scope">strict_range</field>
      <field name="domain">[["parent_state","=","posted"],["tax_line_id","!=",false],["tax_line_id.type_tax_use","=","purchase"]]</field>
    </record>
    <record id="tax_report_net" model="reporting.report.line">
      <field name="report_id" ref="report_tax_report"/>
      <field name="sequence">30</field>
      <field name="name">Net Tax Payable</field>
      <field name="code">NET_TAX</field>
    </record>
    <record id="tax_report_net_tax" model="reporting.report.expression">
      <field name="line_id" ref="tax_report_net"/>
      <field name="label">tax</field>
      <field name="engine">formula</field>
      <field name="formula">SALES_TAX.tax - PURCHASE_TAX.tax</field>
    </record>
  </data>
  <record id="action_tax_report" model="ir.actions.client">
    <field name="name">Tax Report</field>
    <field name="tag">reporting.report</field>
    <field name="params" eval="{'report': ref('report_tax_report')}"/>
  </record>
  <menuitem id="menu_tax_report" name="Tax Report" parent="menu_account_reporting" action="action_tax_report" groups="account.group_account_readonly" sequence="50"/>
  <record id="menu_tax_report" model="ir.ui.menu"><field name="web_icon">lucide:receipt-text</field></record>
</erp>
