<erp noupdate="1">
    <record id="report_general_ledger" model="reporting.report">
        <field name="name">General Ledger</field>
        <field name="provider">account_reporting.general_ledger</field>
        <field name="date_mode">range</field>
        <field name="date_default">this_year</field>
        <field name="multi_company" eval="False"/>
        <field name="comparison" eval="False"/>
        <field name="totals_below" eval="True"/>
        <field name="unfold_all" eval="True"/>
        <field name="search_bar" eval="True"/>
        <field name="hide_zero">optional</field>
    </record>
    <record id="gl_column_date" model="reporting.report.column">
        <field name="report_id" ref="report_general_ledger"/>
        <field name="sequence">10</field>
        <field name="name">Date</field>
        <field name="label">date</field>
        <field name="kind">date</field>
    </record>
    <record id="gl_column_entry" model="reporting.report.column">
        <field name="report_id" ref="report_general_ledger"/>
        <field name="sequence">20</field>
        <field name="name">Journal Entry</field>
        <field name="label">entry</field>
        <field name="kind">text</field>
    </record>
    <record id="gl_column_partner" model="reporting.report.column">
        <field name="report_id" ref="report_general_ledger"/>
        <field name="sequence">25</field>
        <field name="name">Partner</field>
        <field name="label">partner</field>
        <field name="kind">text</field>
    </record>
    <record id="gl_column_debit" model="reporting.report.column">
        <field name="report_id" ref="report_general_ledger"/>
        <field name="sequence">30</field>
        <field name="name">Debit</field>
        <field name="label">debit</field>
        <field name="kind">monetary</field>
        <field name="blank_if_zero" eval="True"/>
    </record>
    <record id="gl_column_credit" model="reporting.report.column">
        <field name="report_id" ref="report_general_ledger"/>
        <field name="sequence">40</field>
        <field name="name">Credit</field>
        <field name="label">credit</field>
        <field name="kind">monetary</field>
        <field name="blank_if_zero" eval="True"/>
    </record>
    <record id="gl_column_balance" model="reporting.report.column">
        <field name="report_id" ref="report_general_ledger"/>
        <field name="sequence">50</field>
        <field name="name">Balance</field>
        <field name="label">balance</field>
        <field name="kind">monetary</field>
    </record>
    <record id="action_general_ledger" model="ir.actions.client">
        <field name="name">General Ledger</field>
        <field name="tag">reporting.report</field>
        <field name="params" eval="{'report': ref('report_general_ledger')}"/>
    </record>
    <menuitem id="menu_general_ledger" name="General Ledger" parent="menu_account_reporting" action="action_general_ledger" groups="account.group_account_readonly" sequence="35"/>
    <record id="menu_general_ledger" model="ir.ui.menu"><field name="web_icon">lucide:book-open</field></record>
</erp>
