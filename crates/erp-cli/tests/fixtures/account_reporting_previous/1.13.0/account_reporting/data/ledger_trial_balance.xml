<erp>
    <data noupdate="1">
        <record id="report_ledger_trial_balance" model="reporting.report">
            <field name="name">Trial Balance</field>
            <field name="provider">account_reporting.trial_balance</field>
            <field name="date_mode">range</field>
            <field name="date_default">this_year</field>
            <field name="multi_company" eval="False"/>
            <field name="comparison" eval="True"/>
            <field name="totals_below" eval="False"/>
            <field name="unfold_all" eval="False"/>
            <field name="search_bar" eval="True"/>
            <field name="hide_zero">optional</field>
        </record>
        <record id="trial_balance_column_opening" model="reporting.report.column">
            <field name="report_id" ref="report_ledger_trial_balance"/>
            <field name="sequence">10</field>
            <field name="name">Initial Balance</field>
            <field name="label">opening</field>
            <field name="kind">monetary</field>
        </record>
        <record id="trial_balance_column_debit" model="reporting.report.column">
            <field name="report_id" ref="report_ledger_trial_balance"/>
            <field name="sequence">20</field>
            <field name="name">Debit</field>
            <field name="label">debit</field>
            <field name="kind">monetary</field>
            <field name="blank_if_zero" eval="True"/>
        </record>
        <record id="trial_balance_column_credit" model="reporting.report.column">
            <field name="report_id" ref="report_ledger_trial_balance"/>
            <field name="sequence">30</field>
            <field name="name">Credit</field>
            <field name="label">credit</field>
            <field name="kind">monetary</field>
            <field name="blank_if_zero" eval="True"/>
        </record>
        <record id="trial_balance_column_closing" model="reporting.report.column">
            <field name="report_id" ref="report_ledger_trial_balance"/>
            <field name="sequence">40</field>
            <field name="name">End Balance</field>
            <field name="label">closing</field>
            <field name="kind">monetary</field>
        </record>
    </data>
    <record id="action_ledger_trial_balance" model="ir.actions.client">
        <field name="name">Trial Balance</field>
        <field name="tag">reporting.report</field>
        <field name="params" eval="{'report': ref('report_ledger_trial_balance')}"/>
    </record>
    <menuitem id="menu_ledger_trial_balance" name="Trial Balance" parent="menu_account_reporting" action="action_ledger_trial_balance" groups="account.group_account_readonly" sequence="30"/>
    <record id="menu_ledger_trial_balance" model="ir.ui.menu"><field name="web_icon">lucide:list</field></record>
</erp>
