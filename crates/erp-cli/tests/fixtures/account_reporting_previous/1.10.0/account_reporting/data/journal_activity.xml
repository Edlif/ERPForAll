<erp>
    <data noupdate="1">
        <record id="report_posted_journal_activity" model="reporting.report">
            <field name="name">Posted Journal Activity</field>
            <field name="multi_company" eval="False"/>
        </record>
        <record id="activity_by_journal" model="reporting.report.line">
            <field name="report_id" ref="report_posted_journal_activity"/>
            <field name="name">Statutory journals</field>
            <field name="code">ACTIVITY</field>
            <field name="groupby">journal_id,account_id</field>
        </record>
        <record id="activity_column_items" model="reporting.report.column">
            <field name="report_id" ref="report_posted_journal_activity"/>
            <field name="sequence">10</field>
            <field name="name">Items</field>
            <field name="label">items</field>
            <field name="kind">integer</field>
            <field name="sortable" eval="True"/>
        </record>
        <record id="activity_expression_items" model="reporting.report.expression">
            <field name="line_id" ref="activity_by_journal"/>
            <field name="label">items</field>
            <field name="model">account.move.line</field>
            <field name="date_field">date</field>
            <field name="domain">[["parent_state","=","posted"],["account_id","!=",false],["journal_id.journal_group_id","=",false]]</field>
        </record>
        <record id="activity_column_debit" model="reporting.report.column">
            <field name="report_id" ref="report_posted_journal_activity"/>
            <field name="sequence">20</field>
            <field name="name">Debit</field>
            <field name="label">debit</field>
            <field name="kind">monetary</field>
            <field name="sortable" eval="True"/>
        </record>
        <record id="activity_expression_debit" model="reporting.report.expression">
            <field name="line_id" ref="activity_by_journal"/>
            <field name="label">debit</field>
            <field name="model">account.move.line</field>
            <field name="field">debit</field>
            <field name="date_field">date</field>
            <field name="domain">[["parent_state","=","posted"],["account_id","!=",false],["journal_id.journal_group_id","=",false]]</field>
        </record>
        <record id="activity_column_credit" model="reporting.report.column">
            <field name="report_id" ref="report_posted_journal_activity"/>
            <field name="sequence">30</field>
            <field name="name">Credit</field>
            <field name="label">credit</field>
            <field name="kind">monetary</field>
            <field name="sortable" eval="True"/>
        </record>
        <record id="activity_expression_credit" model="reporting.report.expression">
            <field name="line_id" ref="activity_by_journal"/>
            <field name="label">credit</field>
            <field name="model">account.move.line</field>
            <field name="field">credit</field>
            <field name="date_field">date</field>
            <field name="domain">[["parent_state","=","posted"],["account_id","!=",false],["journal_id.journal_group_id","=",false]]</field>
        </record>
    </data>
    <record id="action_posted_journal_activity" model="ir.actions.client">
        <field name="name">Posted Journal Activity</field>
        <field name="tag">reporting.report</field>
        <field name="params" eval="{'report': ref('report_posted_journal_activity')}"/>
    </record>
    <menuitem id="menu_account_reporting" name="Reporting" parent="account.menu_finance" groups="account.group_account_readonly" sequence="60"/>
    <record id="menu_account_reporting" model="ir.ui.menu"><field name="web_icon">lucide:chart-column</field></record>
    <menuitem id="menu_posted_journal_activity" name="Posted Journal Activity" parent="menu_account_reporting" action="action_posted_journal_activity" groups="account.group_account_readonly" sequence="10"/>
    <record id="menu_posted_journal_activity" model="ir.ui.menu"><field name="web_icon">lucide:notebook-pen</field></record>
</erp>
