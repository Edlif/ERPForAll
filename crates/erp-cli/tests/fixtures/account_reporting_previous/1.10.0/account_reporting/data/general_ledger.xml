<erp noupdate="1">
    <record id="report_general_ledger" model="reporting.report">
        <field name="name">General Ledger</field>
        <field name="provider">account_reporting.general_ledger</field>
        <field name="multi_company" eval="False"/>
        <field name="comparison" eval="False"/>
        <field name="search_bar" eval="False"/>
    </record>
    <record id="gl_line_gl" model="reporting.report.line">
        <field name="report_id" ref="report_general_ledger"/>
        <field name="sequence">10</field>
        <field name="code">GL</field>
        <field name="name">Posted ledger (before fiscal allocation)</field>
    </record>
    <record id="gl_line_opening" model="reporting.report.line">
        <field name="report_id" ref="report_general_ledger"/>
        <field name="sequence">20</field>
        <field name="code">OPENING</field>
        <field name="name">Opening (raw ledger)</field>
    </record>
    <record id="gl_line_closing" model="reporting.report.line">
        <field name="report_id" ref="report_general_ledger"/>
        <field name="sequence">30</field>
        <field name="code">CLOSING</field>
        <field name="name">Closing (raw ledger)</field>
    </record>
    <record id="gl_line_gl_fiscal" model="reporting.report.line">
        <field name="report_id" ref="report_general_ledger"/>
        <field name="sequence">40</field>
        <field name="code">GL_FISCAL</field>
        <field name="name">Posted ledger (fiscal opening)</field>
    </record>
    <record id="gl_line_opening_fiscal" model="reporting.report.line">
        <field name="report_id" ref="report_general_ledger"/>
        <field name="sequence">50</field>
        <field name="code">OPENING_FISCAL</field>
        <field name="name">Fiscal opening</field>
    </record>
    <record id="gl_line_closing_fiscal" model="reporting.report.line">
        <field name="report_id" ref="report_general_ledger"/>
        <field name="sequence">60</field>
        <field name="code">CLOSING_FISCAL</field>
        <field name="name">Closing balance after fiscal opening</field>
    </record>
    <record id="gl_line_unallocated" model="reporting.report.line">
        <field name="report_id" ref="report_general_ledger"/>
        <field name="sequence">70</field>
        <field name="code">UNALLOCATED</field>
        <field name="name">Unallocated prior-year earnings</field>
    </record>
    <record id="gl_column_date" model="reporting.report.column">
        <field name="report_id" ref="report_general_ledger"/>
        <field name="sequence">10</field>
        <field name="name">Posting date</field>
        <field name="label">date</field>
        <field name="kind">date</field>
    </record>
    <record id="gl_column_entry" model="reporting.report.column">
        <field name="report_id" ref="report_general_ledger"/>
        <field name="sequence">20</field>
        <field name="name">Journal entry</field>
        <field name="label">entry</field>
        <field name="kind">text</field>
    </record>
    <record id="gl_column_debit" model="reporting.report.column">
        <field name="report_id" ref="report_general_ledger"/>
        <field name="sequence">30</field>
        <field name="name">Debit</field>
        <field name="label">debit</field>
        <field name="kind">monetary</field>
    </record>
    <record id="gl_column_credit" model="reporting.report.column">
        <field name="report_id" ref="report_general_ledger"/>
        <field name="sequence">40</field>
        <field name="name">Credit</field>
        <field name="label">credit</field>
        <field name="kind">monetary</field>
    </record>
    <record id="gl_column_balance" model="reporting.report.column">
        <field name="report_id" ref="report_general_ledger"/>
        <field name="sequence">50</field>
        <field name="name">Balance</field>
        <field name="label">balance</field>
        <field name="kind">monetary</field>
    </record>
    <record id="action_general_ledger" model="ir.actions.client">
        <field name="name">General Ledger</field>
        <field name="tag">reporting.report</field>
        <field name="params" eval="{'report': ref('report_general_ledger')}"/>
    </record>
    <menuitem id="menu_general_ledger" name="General Ledger" parent="menu_account_reporting" action="action_general_ledger" groups="account.group_account_readonly" sequence="35"/>
    <record id="menu_general_ledger" model="ir.ui.menu"><field name="web_icon">lucide:book-open</field></record>
</erp>
