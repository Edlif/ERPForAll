<!--
Sales teams: search, list and form (fields of sales_team/views/crm_team_views.xml:4-108, laid
     out anew). The kanban and the dashboard come with.
-->
<erp>
  <record id="crm_team_view_search" model="ir.ui.view">
    <field name="name">crm.team.search</field>
    <field name="model">crm.team</field>
    <field name="arch" type="xml">
      <search string="Sales Teams">
        <field name="name"/>
        <field name="user_id"/>
        <field name="crm_team_member_ids" string="Salesperson" filter_domain="[('crm_team_member_ids.user_id', 'ilike', self)]"/>
        <filter name="my_teams" string="My Teams" domain="['|', ('user_id', '=', uid), ('crm_team_member_ids.user_id', '=', uid)]"/>
        <separator/>
        <filter name="inactive" string="Archived" domain="[('active', '=', False)]"/>
        <group>
          <filter name="groupby_leader" string="Team Leader" context="{'group_by': 'user_id'}"/>
          <filter name="groupby_company" string="Company" context="{'group_by': 'company_id'}"/>
        </group>
      </search>
    </field>
  </record>

  <record id="crm_team_view_tree" model="ir.ui.view">
    <field name="name">crm.team.list</field>
    <field name="model">crm.team</field>
    <field name="arch" type="xml">
      <list>
        <field name="sequence"/>
        <field name="name"/>
        <field name="user_id"/>
        <field name="invoiced_target"/>
        <field name="company_id"/>
        <field name="currency_id" invisible="1"/>
      </list>
    </field>
  </record>

  <record id="crm_team_view_form" model="ir.ui.view">
    <field name="name">crm.team.form</field>
    <field name="model">crm.team</field>
    <field name="arch" type="xml">
      <form record_mode="record">
        <sheet>
          <div class="oe_title">
            <h1><field name="name" placeholder="Team name"/></h1>
          </div>
          <group>
            <group>
              <field name="user_id"/>
              <field name="company_id"/>
              <field name="invoiced_target"/>
              <field name="currency_id" invisible="1"/>
            </group>
            <group>
              <field name="active" invisible="1"/>
              <field name="is_membership_multi" invisible="1"/>
            </group>
          </group>
          <notebook>
            <page string="Members" name="members">
              <field name="member_ids" widget="many2many_tags"/>
            </page>
          </notebook>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>

  <record id="crm_team_action_config" model="ir.actions.act_window">
    <field name="name">Sales Teams</field>
    <field name="res_model">crm.team</field>
    <field name="view_mode">list,form</field>
    <field name="view_id" ref="crm_team_view_tree"/>
    <field name="search_view_id" ref="crm_team_view_search"/>
  </record>
</erp>
