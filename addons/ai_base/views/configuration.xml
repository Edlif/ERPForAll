<erp>
  <record id="provider_list" model="ir.ui.view">
    <field name="name">ai.provider.list</field>
    <field name="model">ai.provider</field>
    <field name="arch" type="xml"><list>
      <field name="name"/><field name="family"/><field name="base_url" string="Endpoint"/>
      <field name="region"/><field name="active"/>
    </list></field>
  </record>
  <record id="provider_form" model="ir.ui.view">
    <field name="name">ai.provider.form</field>
    <field name="model">ai.provider</field>
    <field name="arch" type="xml"><form record_mode="record"><sheet>
      <group string="Connection">
        <field name="name"/><field name="family"/><field name="base_url" string="Endpoint"/>
        <field name="active"/>
      </group>
      <group string="Models">
        <field name="model_limit" string="Maximum model count"/>
        <field name="allowed_models" string="Allowed models (one per line)" widget="ai_base.model_list"/>
      </group>
      <group string="Data handling">
        <field name="region"/><field name="no_training"/><field name="terms_reference"/>
      </group>
    </sheet></form></field>
  </record>
  <record id="provider_action" model="ir.actions.act_window">
    <field name="name">AI Providers</field><field name="res_model">ai.provider</field>
    <field name="view_mode">list,form</field><field name="view_id" ref="provider_list"/>
    <field name="domain">[('active', 'in', [True, False])]</field>
    <field name="group_ids" eval="[(4, ref('base.group_system'), 0)]"/>
  </record>
  <record id="route_list" model="ir.ui.view">
    <field name="name">ai.route.list</field><field name="model">ai.route</field>
    <field name="arch" type="xml"><list>
      <field name="name"/><field name="company_id"/><field name="task_kind"/>
      <field name="provider_id"/><field name="model"/>
    </list></field>
  </record>
  <record id="route_form" model="ir.ui.view">
    <field name="name">ai.route.form</field><field name="model">ai.route</field>
    <field name="arch" type="xml"><form record_mode="record"><sheet>
      <group string="Company route">
        <field name="name"/><field name="company_id"/><field name="task_kind"/>
      </group>
      <group string="Destination"><field name="provider_id"/><field name="model"/></group>
    </sheet></form></field>
  </record>
  <record id="route_action" model="ir.actions.act_window">
    <field name="name">AI Routes</field><field name="res_model">ai.route</field>
    <field name="view_mode">list,form</field><field name="view_id" ref="route_list"/>
    <field name="group_ids" eval="[(4, ref('base.group_system'), 0)]"/>
  </record>
  <menuitem id="configuration_menu" name="AI" parent="base.settings_menu" groups="base.group_system" sequence="65"/>
  <menuitem id="provider_menu" name="Providers" parent="configuration_menu" action="provider_action" groups="base.group_system" sequence="10"/>
  <menuitem id="route_menu" name="Company Routes" parent="configuration_menu" action="route_action" groups="base.group_system" sequence="20"/>
</erp>
