<!-- The default stages, in board order. Done and Cancelled close the work, so they are folded. They belong to no
     project yet: a manager picks the stages of each project on its Stages page. noupdate keeps the changes an
     administrator makes. -->
<erp noupdate="1">
  <record id="task_type_new" model="project.task.type">
    <field name="name">New</field>
    <field name="sequence">10</field>
  </record>
  <record id="task_type_in_progress" model="project.task.type">
    <field name="name">In Progress</field>
    <field name="sequence">20</field>
  </record>
  <record id="task_type_done" model="project.task.type">
    <field name="name">Done</field>
    <field name="sequence">30</field>
    <field name="fold" eval="True"/>
  </record>
  <record id="task_type_cancelled" model="project.task.type">
    <field name="name">Cancelled</field>
    <field name="sequence">40</field>
    <field name="fold" eval="True"/>
  </record>
</erp>
