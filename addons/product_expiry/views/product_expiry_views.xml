<erp>
  <record id="view_product_template_form_expiry" model="ir.ui.view">
    <field name="name">product.template.form.expiry</field>
    <field name="model">product.template</field>
    <field name="inherit_id" ref="stock.product_template_form_stock_buttons"/>
    <field name="arch" type="xml">
      <xpath expr="//group[@name='traceability']" position="after">
        <group name="expiry_dates" string="Dates" groups="stock.group_production_lot">
          <field name="use_expiration_date"/>
          <field name="expiration_time" invisible="not use_expiration_date"/>
          <field name="use_time" invisible="not use_expiration_date"/>
          <field name="removal_time" invisible="not use_expiration_date"/>
          <field name="alert_time" invisible="not use_expiration_date"/>
        </group>
      </xpath>
    </field>
  </record>

  <record id="view_stock_lot_list_expiry" model="ir.ui.view">
    <field name="name">stock.lot.list.expiry</field>
    <field name="model">stock.lot</field>
    <field name="inherit_id" ref="stock.view_stock_lot_list"/>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='company_id']" position="before">
        <field name="expiration_date"/>
        <field name="alert_date"/>
        <field name="product_expiry_alert"/>
      </xpath>
    </field>
  </record>

  <record id="view_stock_lot_form_expiry" model="ir.ui.view">
    <field name="name">stock.lot.form.expiry</field>
    <field name="model">stock.lot</field>
    <field name="inherit_id" ref="stock.view_stock_lot_form"/>
    <field name="arch" type="xml">
      <xpath expr="//sheet/div[@class='oe_title']" position="before">
        <field name="product_expiry_reminded" invisible="1"/>
        <field name="product_expiry_alert" invisible="1"/>
        <widget name="web_ribbon" title="Expired" bg_color="bg-danger" invisible="not product_expiry_reminded"/>
        <widget name="web_ribbon" title="Expiry Alert" bg_color="bg-warning" invisible="product_expiry_reminded or not product_expiry_alert"/>
      </xpath>
      <xpath expr="//sheet/group" position="inside">
        <group string="Dates">
          <field name="expiration_date"/>
          <field name="use_date"/>
          <field name="removal_date"/>
          <field name="alert_date"/>
        </group>
      </xpath>
    </field>
  </record>

  <record id="view_stock_move_line_list_expiry" model="ir.ui.view">
    <field name="name">stock.move.line.list.expiry</field>
    <field name="model">stock.move.line</field>
    <field name="inherit_id" ref="stock.view_stock_move_line_lines"/>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='lot_name']" position="after">
        <field name="expiration_date" groups="stock.group_production_lot"/>
      </xpath>
    </field>
  </record>

  <record id="view_stock_move_line_form_expiry" model="ir.ui.view">
    <field name="name">stock.move.line.form.expiry</field>
    <field name="model">stock.move.line</field>
    <field name="inherit_id" ref="stock.view_stock_move_line_form"/>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='lot_name']" position="after">
        <field name="expiration_date" groups="stock.group_production_lot"/>
      </xpath>
    </field>
  </record>
</erp>
