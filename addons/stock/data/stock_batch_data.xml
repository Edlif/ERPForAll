<!-- The reference of a batch transfer. The result and dialog models ship no records: their rows are
     written by a validation and by the dialog. -->
<erp>
  <data noupdate="1">
    <record id="sequence_picking_batch" model="ir.sequence">
      <field name="name">Batch transfer</field>
      <field name="code">stock.picking.batch</field>
      <field name="prefix">BATCH/</field>
      <field name="padding">5</field>
      <field name="number_next">1</field>
      <field name="number_increment">1</field>
      <field name="company_id" eval="False"/>
    </record>
  </data>
</erp>
