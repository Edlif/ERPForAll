<!-- At install every company gets its warehouse with its locations, operation types and their
     numbering; later companies get theirs when they are created. Not noupdate: every upgrade of
     Inventory runs it again, so a company committed without one (by a node of an older version
     during an install or an upgrade) gets its warehouse at the next upgrade; a company that has
     one is left alone. -->
<odoo>
  <function model="res.company" name="_stock_create_missing_warehouses"/>
</odoo>
