<erp>
  <record id="view_stock_warehouse_list" model="ir.ui.view">
    <field name="name">stock.warehouse.list</field>
    <field name="model">stock.warehouse</field>
    <field name="arch" type="xml">
      <list>
        <field name="sequence"/>
        <field name="name"/>
        <field name="code"/>
        <field name="partner_id"/>
        <field name="company_id"/>
      </list>
    </field>
  </record>
  <record id="view_stock_warehouse_form" model="ir.ui.view">
    <field name="name">stock.warehouse.form</field>
    <field name="model">stock.warehouse</field>
    <field name="arch" type="xml">
      <form record_mode="record">
        <sheet>
          <div class="oe_button_box" name="button_box">
            <button name="action_view_picking_types" type="object" class="oe_stat_button" icon="lucide:workflow">
              <field name="picking_type_count" widget="statinfo" string="Operation Types"/>
            </button>
            <button name="action_view_pickings" type="object" class="oe_stat_button" icon="lucide:truck">
              <field name="picking_count" widget="statinfo" string="Transfers"/>
            </button>
          </div>
          <widget name="web_ribbon" title="Archived" bg_color="bg-danger" invisible="active"/>
          <div class="oe_title"><h1><field name="name"/></h1></div>
          <group>
            <group>
              <field name="code"/>
              <field name="company_id"/>
              <field name="partner_id"/>
            </group>
            <group>
              <field name="sequence"/>
              <field name="active"/>
            </group>
          </group>
          <notebook>
            <page string="Warehouse Configuration" name="configuration">
              <group>
                <group string="Shipments">
                  <field name="reception_steps"/>
                  <field name="delivery_steps"/>
                </group>
                <group string="Locations">
                  <field name="view_location_id"/>
                  <field name="lot_stock_id"/>
                  <field name="wh_input_stock_loc_id"/>
                  <field name="wh_qc_stock_loc_id"/>
                  <field name="wh_output_stock_loc_id"/>
                  <field name="wh_pack_stock_loc_id"/>
                </group>
              </group>
            </page>
            <page string="Technical Information" name="technical">
              <group>
                <group string="Operation Types">
                  <field name="in_type_id"/>
                  <field name="int_type_id"/>
                  <field name="pick_type_id"/>
                  <field name="pack_type_id"/>
                  <field name="out_type_id"/>
                  <field name="qc_type_id"/>
                  <field name="store_type_id"/>
                  <field name="xdock_type_id"/>
                </group>
                <group string="Routes">
                  <field name="reception_route_id"/>
                  <field name="delivery_route_id"/>
                  <field name="route_ids" widget="many2many_tags"/>
                </group>
              </group>
            </page>
            <page string="Resupply From" name="resupply" groups="stock.group_stock_multi_warehouses">
              <field name="resupply_wh_ids"/>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>
  <record id="view_stock_warehouse_search" model="ir.ui.view">
    <field name="name">stock.warehouse.search</field>
    <field name="model">stock.warehouse</field>
    <field name="arch" type="xml">
      <search string="Warehouses">
        <field name="name"/>
        <field name="code"/>
        <field name="company_id"/>
        <filter name="inactive" string="Archived" domain="[('active', '=', False)]"/>
      </search>
    </field>
  </record>
  <record id="action_stock_warehouse" model="ir.actions.act_window">
    <field name="name">Warehouses</field>
    <field name="res_model">stock.warehouse</field>
    <field name="view_mode">list,form</field>
    <field name="view_id" ref="view_stock_warehouse_list"/>
    <field name="search_view_id" ref="view_stock_warehouse_search"/>
  </record>
</erp>
