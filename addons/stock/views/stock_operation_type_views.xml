<erp>
  <record id="view_stock_picking_type_list" model="ir.ui.view">
    <field name="name">stock.picking.type.list</field>
    <field name="model">stock.picking.type</field>
    <field name="arch" type="xml">
      <list>
        <field name="sequence"/>
        <field name="name"/>
        <field name="code"/>
        <field name="warehouse_id"/>
        <field name="default_location_src_id"/>
        <field name="default_location_dest_id"/>
        <field name="company_id"/>
      </list>
    </field>
  </record>
  <record id="view_stock_picking_type_form" model="ir.ui.view">
    <field name="name">stock.picking.type.form</field>
    <field name="model">stock.picking.type</field>
    <field name="arch" type="xml">
      <form record_mode="record">
        <sheet>
          <div class="oe_title"><h1><field name="name"/></h1></div>
          <group>
            <group string="Operation">
              <field name="code"/>
              <field name="sequence_code"/>
              <field name="warehouse_id"/>
              <field name="company_id"/>
              <field name="active"/>
            </group>
            <group string="Locations">
              <field name="default_location_src_id"/>
              <field name="default_location_dest_id"/>
              <field name="return_picking_type_id"/>
            </group>
          </group>
          <notebook>
            <page string="Behavior" name="behavior">
              <group>
                <group>
                  <field name="create_backorder"/>
                  <field name="move_type"/>
                  <field name="reservation_method"/>
                  <field name="print_label"/>
                </group>
                <group string="Lots/Serial Numbers">
                  <field name="use_create_lots"/>
                  <field name="use_existing_lots"/>
                </group>
              </group>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>
  <record id="action_stock_picking_type_config" model="ir.actions.act_window">
    <field name="name">Operation Types</field>
    <field name="res_model">stock.picking.type</field>
    <field name="view_mode">list,form</field>
    <field name="view_id" ref="view_stock_picking_type_list"/>
  </record>
</erp>
