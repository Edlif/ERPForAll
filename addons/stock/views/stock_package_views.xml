<erp>
  <record id="view_stock_package_list" model="ir.ui.view">
    <field name="name">stock.package.list</field>
    <field name="model">stock.package</field>
    <field name="arch" type="xml">
      <list>
        <field name="name"/>
        <field name="package_type_id"/>
        <field name="parent_package_id"/>
        <field name="pack_date"/>
      </list>
    </field>
  </record>
  <record id="view_stock_package_form" model="ir.ui.view">
    <field name="name">stock.package.form</field>
    <field name="model">stock.package</field>
    <field name="arch" type="xml">
      <form record_mode="record">
        <sheet>
          <div class="oe_title"><h1><field name="name"/></h1></div>
          <group>
            <group>
              <field name="package_type_id"/>
              <field name="parent_package_id"/>
              <field name="package_dest_id"/>
            </group>
            <group>
              <field name="pack_date"/>
              <field name="shipping_weight"/>
            </group>
          </group>
          <notebook>
            <page string="Contained Packages" name="children">
              <field name="child_package_ids"/>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>
  <record id="view_stock_package_search" model="ir.ui.view">
    <field name="name">stock.package.search</field>
    <field name="model">stock.package</field>
    <field name="arch" type="xml">
      <search string="Packages">
        <field name="name"/>
        <field name="package_type_id"/>
        <group>
          <filter name="groupby_package_type" string="Package Type" context="{'group_by': 'package_type_id'}"/>
        </group>
      </search>
    </field>
  </record>
  <!--
No Packages action or menu yet: stock.package has no access rows until the packing slice gives it its
       company scope (permission matrix), so the screen would refuse everyone.
  -->

  <record id="view_stock_package_type_list" model="ir.ui.view">
    <field name="name">stock.package.type.list</field>
    <field name="model">stock.package.type</field>
    <field name="arch" type="xml">
      <list>
        <field name="sequence"/>
        <field name="name"/>
        <field name="package_use"/>
        <field name="barcode"/>
        <field name="company_id"/>
      </list>
    </field>
  </record>
  <record id="view_stock_package_type_form" model="ir.ui.view">
    <field name="name">stock.package.type.form</field>
    <field name="model">stock.package.type</field>
    <field name="arch" type="xml">
      <form record_mode="record">
        <sheet>
          <div class="oe_title"><h1><field name="name"/></h1></div>
          <group>
            <group string="Dimensions">
              <field name="packaging_length"/>
              <field name="width"/>
              <field name="height"/>
            </group>
            <group string="Weights">
              <field name="base_weight"/>
              <field name="max_weight"/>
            </group>
          </group>
          <group>
            <group>
              <field name="package_use"/>
              <field name="barcode"/>
            </group>
            <group>
              <field name="company_id"/>
              <field name="sequence"/>
            </group>
          </group>
          <notebook>
            <page string="Routes" name="routes">
              <field name="route_ids"/>
            </page>
            <page string="Storage Capacities" name="capacities">
              <field name="storage_category_capacity_ids"/>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>
  <record id="action_stock_package_type" model="ir.actions.act_window">
    <field name="name">Package Types</field>
    <field name="res_model">stock.package.type</field>
    <field name="view_mode">list,form</field>
    <field name="view_id" ref="view_stock_package_type_list"/>
  </record>
</erp>
