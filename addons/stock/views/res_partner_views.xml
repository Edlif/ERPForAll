<erp>
  <record id="res_partner_form_stock_warnings" model="ir.ui.view">
    <field name="name">res.partner.form.stock.warnings</field>
    <field name="model">res.partner</field>
    <field name="inherit_id" ref="base.partner_form"/>
    <field name="arch" type="xml">
      <xpath expr="//div[@name='button_box']" position="inside">
        <button name="action_view_pickings" type="object" class="oe_stat_button" icon="lucide:truck"
                groups="stock.group_stock_user" invisible="picking_count == 0">
          <field name="picking_count" widget="statinfo" string="Transfers"/>
        </button>
      </xpath>
      <xpath expr="//page[@name='details']" position="inside">
        <group name="stock_warnings" string="Notice on stock transfers" groups="stock.group_warning_stock">
          <field name="picking_warn_msg" placeholder="e.g. Call the site contact before arriving."/>
        </group>
      </xpath>
    </field>
  </record>

  <record id="product_template_form_stock_buttons" model="ir.ui.view">
    <field name="name">product.template.form.stock.buttons</field>
    <field name="model">product.template</field>
    <field name="inherit_id" ref="product.product_template_form_view"/>
    <field name="arch" type="xml">
      <xpath expr="//div[@name='button_box']" position="inside">
        <button name="action_open_quants" type="object" class="oe_stat_button" icon="lucide:boxes"
                groups="stock.group_stock_user" invisible="not is_storable">
          <field name="qty_on_hand" widget="statinfo" string="On Hand"/>
        </button>
        <button name="action_open_forecasted" type="object" class="oe_stat_button" icon="lucide:trending-up"
                groups="stock.group_stock_user" invisible="not is_storable">
          <field name="virtual_available" widget="statinfo" string="Forecasted"/>
        </button>
        <button name="action_open_stock_moves" type="object" class="oe_stat_button" icon="lucide:workflow"
                groups="stock.group_stock_user" invisible="stock_move_count == 0">
          <field name="stock_move_count" widget="statinfo" string="Moves"/>
        </button>
        <button name="action_open_orderpoints" type="object" class="oe_stat_button" icon="lucide:refresh-cw"
                groups="stock.group_stock_user" invisible="not is_storable">
          <field name="reordering_rule_count" widget="statinfo" string="Reordering"/>
        </button>
      </xpath>
      <xpath expr="//notebook" position="inside">
        <page name="inventory" string="Inventory" groups="stock.group_stock_user">
          <group>
            <group name="operations" string="Operations">
              <field name="route_ids" groups="stock.group_adv_location"/>
              <field name="qty_incoming" readonly="1" invisible="not is_storable"/>
              <field name="qty_outgoing" readonly="1" invisible="not is_storable"/>
              <field name="virtual_available" readonly="1" invisible="not is_storable"/>
            </group>
            <group name="traceability" string="Traceability">
              <field name="tracking" groups="stock.group_production_lot"/>
            </group>
            <group name="logistics" string="Logistics">
              <field name="weight"/>
              <field name="volume"/>
            </group>
          </group>
        </page>
      </xpath>
    </field>
  </record>
</erp>
