<erp>
  <record id="res_partner_form_stock_warnings" model="ir.ui.view">
    <field name="name">res.partner.form.stock.warnings</field>
    <field name="model">res.partner</field>
    <field name="inherit_id" ref="base.partner_form"/>
    <field name="arch" type="xml">
      <xpath expr="//page[@name='details']" position="inside">
        <group name="stock_warnings" string="Notice on stock transfers" groups="stock.group_warning_stock">
          <field name="picking_warn_msg" placeholder="e.g. Call the site contact before arriving."/>
        </group>
      </xpath>
    </field>
  </record>
</erp>
