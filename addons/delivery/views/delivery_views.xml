<erp>
  <record id="view_delivery_price_rule_list" model="ir.ui.view">
    <field name="name">delivery.price.rule.list</field>
    <field name="model">delivery.price.rule</field>
    <field name="arch" type="xml">
      <list>
        <field name="sequence"/>
        <field name="name"/>
        <field name="variable"/>
        <field name="operator"/>
        <field name="max_value"/>
        <field name="list_base_price"/>
        <field name="list_price"/>
        <field name="variable_factor"/>
      </list>
    </field>
  </record>

  <record id="view_delivery_price_rule_form" model="ir.ui.view">
    <field name="name">delivery.price.rule.form</field>
    <field name="model">delivery.price.rule</field>
    <field name="arch" type="xml">
      <form string="Delivery Price Rule">
        <sheet>
          <group>
            <group string="Condition">
              <field name="sequence"/>
              <field name="variable"/>
              <field name="operator"/>
              <field name="max_value"/>
            </group>
            <group string="Price">
              <field name="list_base_price"/>
              <field name="list_price"/>
              <field name="variable_factor"/>
            </group>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="view_delivery_carrier_list" model="ir.ui.view">
    <field name="name">delivery.carrier.list</field>
    <field name="model">delivery.carrier</field>
    <field name="arch" type="xml">
      <list string="Shipping Methods">
        <field name="sequence"/>
        <field name="name"/>
        <field name="delivery_type"/>
        <field name="product_id"/>
        <field name="fixed_price"/>
        <field name="free_over"/>
        <field name="company_id"/>
      </list>
    </field>
  </record>

  <record id="view_delivery_carrier_form" model="ir.ui.view">
    <field name="name">delivery.carrier.form</field>
    <field name="model">delivery.carrier</field>
    <field name="arch" type="xml">
      <form string="Shipping Method">
        <sheet>
          <div class="oe_title">
            <h1><field name="name" placeholder="e.g. Standard Delivery"/></h1>
          </div>
          <group>
            <group>
              <field name="delivery_type"/>
              <field name="product_id"/>
              <field name="sequence"/>
              <field name="company_id"/>
            </group>
            <group>
              <field name="margin"/>
              <field name="fixed_margin"/>
              <field name="free_over"/>
              <field name="amount" invisible="not free_over"/>
              <field name="tracking_label" placeholder="e.g. https://track.example.com/{ref}"/>
            </group>
          </group>
          <notebook>
            <page name="pricing" string="Pricing">
              <group>
                <field name="fixed_price" invisible="delivery_type != 'fixed'"/>
              </group>
              <field name="price_rule_ids" invisible="delivery_type != 'base_on_rule'"/>
            </page>
            <page name="description" string="Description">
              <group>
                <field name="carrier_description" placeholder="Customer-facing shipping terms and delivery window..."/>
              </group>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <record id="view_delivery_carrier_search" model="ir.ui.view">
    <field name="name">delivery.carrier.search</field>
    <field name="model">delivery.carrier</field>
    <field name="arch" type="xml">
      <search string="Shipping Methods">
        <field name="name"/>
        <field name="delivery_type"/>
        <filter name="filter_fixed" string="Fixed Price" domain="[('delivery_type', '=', 'fixed')]"/>
        <filter name="filter_rules" string="Based on Rules" domain="[('delivery_type', '=', 'base_on_rule')]"/>
        <group>
          <filter name="group_provider" string="Provider" context="{'group_by': 'delivery_type'}"/>
          <filter name="group_company" string="Company" context="{'group_by': 'company_id'}"/>
        </group>
      </search>
    </field>
  </record>

  <record id="action_delivery_carrier" model="ir.actions.act_window">
    <field name="name">Shipping Methods</field>
    <field name="res_model">delivery.carrier</field>
    <field name="view_mode">list,form</field>
    <field name="target">current</field>
    <field name="search_view_id" ref="view_delivery_carrier_search"/>
  </record>
</erp>
