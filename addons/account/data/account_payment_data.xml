<!-- Default payment methods: manual payments in both directions, as the reference ships them.
     Every bank, cash and credit-card journal gets a line of each (journal create). -->
<erp>
  <data noupdate="1">
    <record id="account_payment_method_manual_in" model="account.payment.method">
      <field name="name">Manual Payment</field>
      <field name="code">manual</field>
      <field name="payment_type">inbound</field>
    </record>
    <record id="account_payment_method_manual_out" model="account.payment.method">
      <field name="name">Manual Payment</field>
      <field name="code">manual</field>
      <field name="payment_type">outbound</field>
    </record>
    <record id="account_payment_method_check" model="account.payment.method">
      <field name="name">Checks</field>
      <field name="code">check_printing</field>
      <field name="payment_type">outbound</field>
    </record>
  </data>
</erp>
