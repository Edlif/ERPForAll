<!-- Recurring & Deferred Entries: Accounting > Accounting > Recurring & Deferred -->
<erp>
  <record id="view_account_recurring_entry_list" model="ir.ui.view">
    <field name="name">account.recurring.entry.list</field>
    <field name="model">account.recurring.entry</field>
    <field name="arch" type="xml">
      <list>
        <field name="name"/>
        <field name="entry_kind"/>
        <field name="start_date"/>
        <field name="next_date"/>
        <field name="posted_periods"/>
        <field name="total_periods"/>
        <field name="total_amount"/>
        <field name="currency_id"/>
        <field name="state" widget="badge" options="{'tone_warning': ['draft'], 'tone_info': ['running'], 'tone_success': ['done']}"/>
      </list>
    </field>
  </record>

  <record id="view_account_recurring_entry_form" model="ir.ui.view">
    <field name="name">account.recurring.entry.form</field>
    <field name="model">account.recurring.entry</field>
    <field name="arch" type="xml">
      <form string="Recurring / Deferred Entry">
        <header>
          <button name="action_start" type="object" string="Start Schedule" class="btn-primary" invisible="state != 'draft'"/>
          <button name="action_post_next_entry" type="object" string="Post Next Period" class="btn-primary" invisible="state != 'running'"/>
          <button name="action_reset_draft" type="object" string="Reset to Draft" invisible="state != 'running'"/>
          <field name="state" widget="statusbar" statusbar_visible="draft,running,done"/>
        </header>
        <sheet>
          <div class="oe_title"><h1><field name="name" placeholder="e.g. Prepaid Rent Amortization" readonly="state != 'draft'"/></h1></div>
          <group>
            <group>
              <field name="entry_kind" readonly="state != 'draft'"/>
              <field name="journal_id" readonly="state != 'draft'"/>
              <field name="debit_account_id" readonly="state != 'draft'"/>
              <field name="credit_account_id" readonly="state != 'draft'"/>
              <field name="partner_id" readonly="state != 'draft'"/>
            </group>
            <group>
              <field name="start_date" readonly="state != 'draft'"/>
              <field name="period_months" readonly="state != 'draft'"/>
              <field name="total_periods" readonly="state != 'draft'"/>
              <field name="total_amount" readonly="state != 'draft'"/>
              <field name="posted_periods" readonly="1"/>
              <field name="next_date" readonly="1"/>
              <field name="last_move_id" readonly="1" invisible="not last_move_id"/>
              <field name="currency_id" readonly="1"/>
              <field name="company_id" readonly="1"/>
            </group>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="action_account_recurring_entry" model="ir.actions.act_window">
    <field name="name">Recurring &amp; Deferred</field>
    <field name="res_model">account.recurring.entry</field>
    <field name="view_mode">list,form</field>
    <field name="view_id" ref="view_account_recurring_entry_list"/>
  </record>

  <menuitem id="menu_account_recurring_entry" name="Recurring &amp; Deferred" parent="menu_finance_entries" action="action_account_recurring_entry" sequence="55"/>
  <record id="menu_account_recurring_entry" model="ir.ui.menu"><field name="web_icon">lucide:refresh-cw</field></record>
</erp>
