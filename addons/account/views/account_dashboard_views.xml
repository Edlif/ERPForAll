<!-- The accounting dashboard: one card per journal shown on the dashboard (Accounting > Dashboard). -->
<erp>
  <record id="account_journal_dashboard_kanban_view" model="ir.ui.view">
    <field name="name">account.journal.dashboard.kanban</field>
    <field name="model">account.journal</field>
    <field name="arch" type="xml">
      <kanban string="Accounting Dashboard" create="0" can_open="0">
        <templates>
          <t t-name="card">
            <main>
              <field name="name"/>
              <field name="type"/>
              <field name="dashboard_card" widget="dashboard_card"/>
            </main>
          </t>
        </templates>
      </kanban>
    </field>
  </record>

  <record id="open_account_journal_dashboard_kanban" model="ir.actions.act_window">
    <field name="name">Accounting Dashboard</field>
    <field name="res_model">account.journal</field>
    <field name="view_mode">kanban,form</field>
    <field name="view_id" ref="account_journal_dashboard_kanban_view"/>
    <field name="domain">[('show_on_dashboard', '=', True)]</field>
  </record>

  <menuitem id="menu_board_journal_1" name="Dashboard" parent="menu_finance" action="open_account_journal_dashboard_kanban" sequence="1"/>

  <record id="menu_board_journal_1" model="ir.ui.menu"><field name="web_icon">lucide:panels-top-left</field></record>
</erp>
