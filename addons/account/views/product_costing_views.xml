<erp>
  <record id="product_category_cost_policy_form" model="ir.ui.view">
    <field name="name">product.category.cost.policy</field>
    <field name="model">product.category</field>
    <field name="inherit_id" ref="product.product_category_form_view"/>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='parent_id']" position="after">
        <field name="property_cost_method" groups="product.group_product_manager"/>
      </xpath>
    </field>
  </record>
  <record id="product_template_cost_policy_form" model="ir.ui.view">
    <field name="name">product.template.cost.policy</field>
    <field name="model">product.template</field>
    <field name="inherit_id" ref="product.product_template_form_view"/>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='standard_price']" position="before">
        <field name="cost_method" readonly="1"/>
      </xpath>
    </field>
  </record>
</erp>
