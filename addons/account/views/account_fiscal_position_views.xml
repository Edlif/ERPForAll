<!-- Fiscal Positions: Accounting > Configuration > Fiscal Positions -->
<erp>
  <record id="view_account_fiscal_position_account_list" model="ir.ui.view">
    <field name="name">account.fiscal.position.account.list</field>
    <field name="model">account.fiscal.position.account</field>
    <field name="arch" type="xml">
      <list>
        <field name="account_src_id"/>
        <field name="account_dest_id"/>
      </list>
    </field>
  </record>

  <record id="view_account_fiscal_position_account_form" model="ir.ui.view">
    <field name="name">account.fiscal.position.account.form</field>
    <field name="model">account.fiscal.position.account</field>
    <field name="arch" type="xml">
      <form string="Account Mapping">
        <sheet>
          <group>
            <field name="account_src_id"/>
            <field name="account_dest_id"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="view_account_fiscal_position_list" model="ir.ui.view">
    <field name="name">account.fiscal.position.list</field>
    <field name="model">account.fiscal.position</field>
    <field name="arch" type="xml">
      <list>
        <field name="sequence"/>
        <field name="name"/>
        <field name="auto_apply"/>
        <field name="country_id"/>
        <field name="country_group_id"/>
        <field name="company_id"/>
        <field name="active"/>
      </list>
    </field>
  </record>

  <record id="view_account_fiscal_position_form" model="ir.ui.view">
    <field name="name">account.fiscal.position.form</field>
    <field name="model">account.fiscal.position</field>
    <field name="arch" type="xml">
      <form string="Fiscal Position">
        <sheet>
          <div class="oe_title">
            <h1><field name="name" placeholder="e.g. Export / Tax Exempt"/></h1>
          </div>
          <group>
            <group>
              <field name="auto_apply"/>
              <field name="vat_required" invisible="not auto_apply"/>
              <field name="foreign_vat"/>
              <field name="active"/>
            </group>
            <group>
              <field name="country_group_id" invisible="not auto_apply"/>
              <field name="country_id" invisible="not auto_apply"/>
              <field name="state_ids" widget="many2many_tags" invisible="not auto_apply or not country_id"/>
              <field name="zip_from" invisible="not auto_apply"/>
              <field name="zip_to" invisible="not auto_apply"/>
              <field name="company_id" readonly="1"/>
            </group>
          </group>
          <notebook>
            <page string="Tax Mapping" name="tax_mapping">
              <group>
                <field name="tax_ids" widget="many2many_tags" string="Taxes Applied"/>
              </group>
            </page>
            <page string="Account Mapping" name="account_mapping">
              <field name="account_ids"/>
            </page>
            <page string="Legal Notes" name="notes">
              <field name="note"/>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <record id="view_account_fiscal_position_search" model="ir.ui.view">
    <field name="name">account.fiscal.position.search</field>
    <field name="model">account.fiscal.position</field>
    <field name="arch" type="xml">
      <search string="Fiscal Positions">
        <field name="name"/>
        <field name="country_id"/>
        <field name="country_group_id"/>
        <filter name="auto_apply" string="Detect Automatically" domain="[('auto_apply', '=', True)]"/>
        <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
        <group>
          <filter name="groupby_country" string="Country" context="{'group_by': 'country_id'}"/>
        </group>
      </search>
    </field>
  </record>

  <record id="action_account_fiscal_position_form" model="ir.actions.act_window">
    <field name="name">Fiscal Positions</field>
    <field name="res_model">account.fiscal.position</field>
    <field name="view_mode">list,form</field>
    <field name="view_id" ref="view_account_fiscal_position_list"/>
    <field name="search_view_id" ref="view_account_fiscal_position_search"/>
  </record>

  <menuitem id="menu_action_account_fiscal_position_form"
            name="Fiscal Positions"
            parent="menu_finance_configuration"
            action="action_account_fiscal_position_form"
            groups="account.group_account_manager"
            sequence="65"/>
  <record id="menu_action_account_fiscal_position_form" model="ir.ui.menu">
    <field name="web_icon">lucide:globe</field>
  </record>
</erp>
