<erp>
  <record id="view_payment_term_list" model="ir.ui.view">
    <field name="name">account.payment.term.list</field><field name="model">account.payment.term</field>
    <field name="arch" type="xml"><list><field name="sequence"/><field name="name"/><field name="company_id"/><field name="display_on_invoice"/></list></field>
  </record>
  <record id="view_payment_term_form" model="ir.ui.view">
    <field name="name">account.payment.term.form</field><field name="model">account.payment.term</field>
    <field name="arch" type="xml"><form record_mode="record"><sheet>
      <div class="oe_title"><h1><field name="name"/></h1></div>
      <group><group><field name="company_id"/><field name="sequence"/></group>
      <group><field name="display_on_invoice"/><field name="active"/></group></group>
      <group string="Instalments"><field name="line_ids" nolabel="1"/></group>
      <group><field name="note"/></group>
    </sheet></form></field>
  </record>
  <record id="view_payment_term_line_list" model="ir.ui.view">
    <field name="name">account.payment.term.line.list</field><field name="model">account.payment.term.line</field>
    <field name="arch" type="xml"><list><field name="value"/><field name="value_amount"/><field name="delay_type"/><field name="nb_days"/><field name="days_next_month"/></list></field>
  </record>
  <record id="view_payment_term_line_form" model="ir.ui.view">
    <field name="name">account.payment.term.line.form</field><field name="model">account.payment.term.line</field>
    <field name="arch" type="xml"><form record_mode="record"><sheet><group><field name="payment_id" invisible="1"/><field name="value"/><field name="value_amount"/><field name="delay_type"/><field name="nb_days"/><field name="days_next_month" invisible="delay_type != 'days_end_of_month_on_the'"/></group></sheet></form></field>
  </record>
  <record id="action_payment_term" model="ir.actions.act_window">
    <field name="name">Payment Terms</field><field name="res_model">account.payment.term</field><field name="view_mode">list,form</field>
  </record>
</erp>
