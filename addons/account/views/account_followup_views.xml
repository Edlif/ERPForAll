<!-- Follow-Up Levels (Configuration) & Customer Follow-Ups (Customers) -->
<erp>
  <record id="view_account_followup_level_list" model="ir.ui.view">
    <field name="name">account.followup.level.list</field>
    <field name="model">account.followup.level</field>
    <field name="arch" type="xml">
      <list>
        <field name="name"/>
        <field name="delay"/>
        <field name="send_email"/>
        <field name="send_sms"/>
        <field name="auto_execute"/>
        <field name="company_id"/>
      </list>
    </field>
  </record>

  <record id="view_account_followup_level_form" model="ir.ui.view">
    <field name="name">account.followup.level.form</field>
    <field name="model">account.followup.level</field>
    <field name="arch" type="xml">
      <form string="Follow-up Level">
        <sheet>
          <div class="oe_title">
            <h1><field name="name" placeholder="e.g. First Reminder"/></h1>
          </div>
          <group>
            <group>
              <field name="delay"/>
              <field name="company_id"/>
              <field name="auto_execute"/>
            </group>
            <group>
              <field name="send_email"/>
              <field name="send_sms"/>
              <field name="join_invoices"/>
            </group>
          </group>
          <group string="Reminder Message">
            <field name="note"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="action_account_followup_level" model="ir.actions.act_window">
    <field name="name">Follow-up Levels</field>
    <field name="res_model">account.followup.level</field>
    <field name="view_mode">list,form</field>
    <field name="view_id" ref="view_account_followup_level_list"/>
  </record>

  <menuitem id="menu_account_followup_level"
            name="Follow-up Levels"
            parent="menu_finance_configuration"
            action="action_account_followup_level"
            groups="account.group_account_manager"
            sequence="72"/>
  <record id="menu_account_followup_level" model="ir.ui.menu"><field name="web_icon">lucide:list-todo</field></record>

  <record id="view_account_followup_report_list" model="ir.ui.view">
    <field name="name">account.followup.report.list</field>
    <field name="model">account.followup.report</field>
    <field name="arch" type="xml">
      <list>
        <field name="name"/>
        <field name="partner_id"/>
        <field name="followup_level_id"/>
        <field name="overdue_invoice_count"/>
        <field name="max_days_overdue"/>
        <field name="total_overdue"/>
        <field name="total_due"/>
        <field name="currency_id"/>
        <field name="status" widget="badge" options="{'tone_danger': ['in_need_of_action'], 'tone_warning': ['with_overdue_invoices'], 'tone_success': ['no_action_needed']}"/>
      </list>
    </field>
  </record>

  <record id="view_account_followup_report_form" model="ir.ui.view">
    <field name="name">account.followup.report.form</field>
    <field name="model">account.followup.report</field>
    <field name="arch" type="xml">
      <form string="Customer Follow-up">
        <header>
          <button name="action_compute_overdue" type="object" string="Refresh Overdue"/>
          <button name="action_send_reminder" type="object" string="Send Reminder" class="btn-primary"/>
          <field name="status" widget="statusbar" statusbar_visible="in_need_of_action,with_overdue_invoices,no_action_needed"/>
        </header>
        <sheet>
          <div class="oe_button_box" name="button_box">
            <button name="action_view_overdue_invoices" type="object" class="oe_stat_button" icon="lucide:receipt-text">
              <field name="overdue_invoice_count" widget="statinfo" string="Overdue Invoices"/>
            </button>
          </div>
          <div class="oe_title">
            <h1><field name="name" readonly="1"/></h1>
          </div>
          <group>
            <group>
              <field name="partner_id"/>
              <field name="followup_level_id"/>
              <field name="company_id" readonly="1"/>
              <field name="currency_id" readonly="1"/>
            </group>
            <group>
              <field name="total_due" readonly="1"/>
              <field name="total_overdue" readonly="1"/>
              <field name="max_days_overdue" readonly="1"/>
              <field name="last_reminder_date" readonly="1"/>
              <field name="next_reminder_date"/>
            </group>
          </group>
          <group string="Customer Statement Summary">
            <field name="summary" readonly="1"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="view_account_followup_report_search" model="ir.ui.view">
    <field name="name">account.followup.report.search</field>
    <field name="model">account.followup.report</field>
    <field name="arch" type="xml">
      <search string="Customer Follow-ups">
        <field name="name"/>
        <field name="partner_id"/>
        <field name="followup_level_id"/>
        <filter name="need_action" string="In Need of Action" domain="[('status', '=', 'in_need_of_action')]"/>
        <filter name="overdue" string="With Overdue Invoices" domain="[('total_overdue', '>', 0)]"/>
        <group>
          <filter name="groupby_level" string="Follow-up Level" context="{'group_by': 'followup_level_id'}"/>
          <filter name="groupby_status" string="Status" context="{'group_by': 'status'}"/>
        </group>
      </search>
    </field>
  </record>

  <record id="action_account_followup_report" model="ir.actions.act_window">
    <field name="name">Follow-up Reports</field>
    <field name="res_model">account.followup.report</field>
    <field name="view_mode">list,form</field>
    <field name="view_id" ref="view_account_followup_report_list"/>
    <field name="search_view_id" ref="view_account_followup_report_search"/>
  </record>

  <menuitem id="menu_account_followup_report"
            name="Follow-up Reports"
            parent="menu_finance_receivables"
            action="action_account_followup_report"
            sequence="25"/>
  <record id="menu_account_followup_report" model="ir.ui.menu"><field name="web_icon">lucide:list-todo</field></record>
</erp>
