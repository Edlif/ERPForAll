<erp>
    <record id="view_invoice_form_inherit_mail" model="ir.ui.view">
        <field name="name">account.move.invoice.form.inherit.mail</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_invoice_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="after">
                <chatter/>
            </xpath>
        </field>
    </record>
    <record id="view_move_form_inherit_mail" model="ir.ui.view">
        <field name="name">account.move.form.inherit.mail</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="after">
                <chatter/>
            </xpath>
        </field>
    </record>
</erp>
