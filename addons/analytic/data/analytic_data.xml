<erp>
  <data noupdate="1">
    <record id="analytic_plan_projects" model="account.analytic.plan">
      <field name="name">Projects</field>
      <field name="description">Track revenues and costs per customer project.</field>
      <field name="default_applicability">optional</field>
    </record>
    <record id="analytic_plan_departments" model="account.analytic.plan">
      <field name="name">Departments</field>
      <field name="description">Track costs and budgets by internal cost center.</field>
      <field name="default_applicability">optional</field>
    </record>
    <record id="analytic_account_internal" model="account.analytic.account">
      <field name="name">Internal Operations</field>
      <field name="code">INT-OPS</field>
      <field name="plan_id" ref="analytic_plan_departments"/>
      <field name="company_id" ref="base.main_company"/>
    </record>
    <record id="analytic_account_services" model="account.analytic.account">
      <field name="name">Client Services</field>
      <field name="code">PRJ-SVC</field>
      <field name="plan_id" ref="analytic_plan_projects"/>
      <field name="company_id" ref="base.main_company"/>
    </record>
  </data>
</erp>
