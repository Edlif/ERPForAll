<erp>
    <record id="purchase_line_list_received" model="ir.ui.view">
        <field name="name">purchase.line.list.received</field>
        <field name="model">purchase.order.line</field>
        <field name="inherit_id" ref="purchase.view_purchase_order_line_list"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='qty_received']" position="replace">
                <field name="qty_received" readonly="1"/>
            </xpath>
        </field>
    </record>
</erp>
