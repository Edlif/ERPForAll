<?xml version="1.0" encoding="utf-8"?>
<!-- Demo quotations referencing base demo customers, sales_team demo teams, and product demo catalog. -->
<erp>
  <record id="sale_order_demo_1" model="sale.order">
    <field name="name">SO-DEMO-001</field>
    <field name="company_id" ref="base.main_company"/>
    <field name="partner_id" ref="base.partner_demo_toko_maju"/>
    <field name="partner_invoice_id" ref="base.partner_demo_toko_maju"/>
    <field name="partner_shipping_id" ref="base.partner_demo_toko_maju"/>
    <field name="date_order">2026-11-20 09:00:00</field>
    <field name="team_id" ref="sales_team.team_demo_corporate"/>
    <field name="client_order_ref">PO-TM-2026-01</field>
  </record>
  <record id="sale_order_line_demo_1_rak" model="sale.order.line">
    <field name="order_id" ref="sale_order_demo_1"/>
    <field name="product_id" search="[('product_tmpl_id', '=', ref('product.product_demo_rak'))]"/>
    <field name="name">Rak Buku Minimalis</field>
    <field name="product_uom_qty">4</field>
    <field name="price_unit">120</field>
    <field name="customer_lead">3</field>
  </record>
  <record id="sale_order_line_demo_1_kopi" model="sale.order.line">
    <field name="order_id" ref="sale_order_demo_1"/>
    <field name="product_id" search="[('product_tmpl_id', '=', ref('product.product_demo_kopi'))]"/>
    <field name="name">Kopi Arabika Gunung 250 g</field>
    <field name="product_uom_qty">10</field>
    <field name="price_unit">9</field>
    <field name="customer_lead">1</field>
  </record>

  <record id="sale_order_demo_2" model="sale.order">
    <field name="name">SO-DEMO-002</field>
    <field name="company_id" ref="base.main_company"/>
    <field name="partner_id" ref="base.partner_demo_griya_persada"/>
    <field name="partner_invoice_id" ref="base.partner_demo_griya_persada"/>
    <field name="partner_shipping_id" ref="base.partner_demo_griya_persada"/>
    <field name="date_order">2026-11-21 10:30:00</field>
    <field name="team_id" ref="sales_team.team_demo_online"/>
    <field name="client_order_ref">PO-GP-2026-04</field>
  </record>
  <record id="sale_order_line_demo_2_laptop" model="sale.order.line">
    <field name="order_id" ref="sale_order_demo_2"/>
    <field name="product_id" search="[('product_tmpl_id', '=', ref('product.product_demo_laptop'))]"/>
    <field name="name">Laptop Kerja 14 inci</field>
    <field name="product_uom_qty">2</field>
    <field name="price_unit">850</field>
    <field name="customer_lead">5</field>
  </record>
  <record id="sale_order_line_demo_2_mouse" model="sale.order.line">
    <field name="order_id" ref="sale_order_demo_2"/>
    <field name="product_id" search="[('product_tmpl_id', '=', ref('product.product_demo_mouse'))]"/>
    <field name="name">Mouse Nirkabel</field>
    <field name="product_uom_qty">4</field>
    <field name="price_unit">15</field>
    <field name="customer_lead">2</field>
