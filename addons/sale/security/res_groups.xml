<!-- The five feature groups of Sales (sale/security/res_groups.xml:4-22), classified as light
     feature groups: no implied group, no access row, nobody holds them until a setting does. The
     lock switch is the declared setting sale.lock_confirmed_sales; the other four switches come
     with the Sales settings page. -->
<erp noupdate="1">
  <record id="group_auto_done_setting" model="res.groups">
    <field name="name">Confirmed sales orders locked</field>
  </record>
  <record id="group_discount_per_so_line" model="res.groups">
    <field name="name">Line discounts on sales orders</field>
  </record>
  <record id="group_warning_sale" model="res.groups">
    <field name="name">Sales warnings on products and customers</field>
  </record>
  <record id="group_proforma_sales" model="res.groups">
    <field name="name">Sales pro-forma invoices</field>
  </record>
  <record id="group_services_and_material" model="res.groups">
    <field name="name">Services and materials on sales orders</field>
  </record>
</erp>
