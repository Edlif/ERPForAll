<erp>
    <data noupdate="1">
        <record id="report_ledger_trial_balance" model="reporting.report">
            <field name="name">Ledger Trial Balance</field>
            <field name="multi_company" eval="False"/>
        </record>
        <record id="trial_balance_by_account" model="reporting.report.line">
            <field name="report_id" ref="report_ledger_trial_balance"/>
            <field name="name">Visible ledger balances (before fiscal allocation)</field>
            <field name="code">TRIAL_BALANCE</field>
            <field name="groupby">account_id</field>
        </record>
        <record id="trial_balance_column_opening" model="reporting.report.column">
            <field name="report_id" ref="report_ledger_trial_balance"/>
            <field name="sequence">10</field>
            <field name="name">Opening (raw ledger)</field>
            <field name="label">opening</field>
            <field name="kind">monetary</field>
        </record>
        <record id="trial_balance_expression_opening" model="reporting.report.expression">
            <field name="line_id" ref="trial_balance_by_account"/>
            <field name="label">opening</field>
            <field name="model">account.move.line</field>
            <field name="field">balance</field>
            <field name="date_field">date</field>
            <field name="date_scope">before_period</field>
            <field name="domain">[["parent_state","=","posted"],["account_id","!=",false],["journal_id.journal_group_id","=",false]]</field>
        </record>
        <record id="trial_balance_column_debit" model="reporting.report.column">
            <field name="report_id" ref="report_ledger_trial_balance"/>
            <field name="sequence">20</field>
            <field name="name">Period debit</field>
            <field name="label">debit</field>
            <field name="kind">monetary</field>
        </record>
        <record id="trial_balance_expression_debit" model="reporting.report.expression">
            <field name="line_id" ref="trial_balance_by_account"/>
            <field name="label">debit</field>
            <field name="model">account.move.line</field>
            <field name="field">debit</field>
            <field name="date_field">date</field>
            <field name="date_scope">strict_range</field>
            <field name="domain">[["parent_state","=","posted"],["account_id","!=",false],["journal_id.journal_group_id","=",false]]</field>
        </record>
        <record id="trial_balance_column_credit" model="reporting.report.column">
            <field name="report_id" ref="report_ledger_trial_balance"/>
            <field name="sequence">30</field>
            <field name="name">Period credit</field>
            <field name="label">credit</field>
            <field name="kind">monetary</field>
        </record>
        <record id="trial_balance_expression_credit" model="reporting.report.expression">
            <field name="line_id" ref="trial_balance_by_account"/>
            <field name="label">credit</field>
            <field name="model">account.move.line</field>
            <field name="field">credit</field>
            <field name="date_field">date</field>
            <field name="date_scope">strict_range</field>
            <field name="domain">[["parent_state","=","posted"],["account_id","!=",false],["journal_id.journal_group_id","=",false]]</field>
        </record>
        <record id="trial_balance_column_closing" model="reporting.report.column">
            <field name="report_id" ref="report_ledger_trial_balance"/>
            <field name="sequence">40</field>
            <field name="name">Closing (raw ledger)</field>
            <field name="label">closing</field>
            <field name="kind">monetary</field>
        </record>
        <record id="trial_balance_expression_closing" model="reporting.report.expression">
            <field name="line_id" ref="trial_balance_by_account"/>
            <field name="label">closing</field>
            <field name="model">account.move.line</field>
            <field name="field">balance</field>
            <field name="date_field">date</field>
            <field name="date_scope">from_beginning</field>
            <field name="domain">[["parent_state","=","posted"],["account_id","!=",false],["journal_id.journal_group_id","=",false]]</field>
        </record>
    </data>
    <record id="action_ledger_trial_balance" model="ir.actions.client">
        <field name="name">Ledger Trial Balance</field>
        <field name="tag">reporting.report</field>
        <field name="params" eval="{'report': ref('report_ledger_trial_balance')}"/>
    </record>
    <menuitem id="menu_ledger_trial_balance" name="Ledger Trial Balance" parent="menu_account_reporting" action="action_ledger_trial_balance" groups="account.group_account_readonly" sequence="30"/>
</erp>
