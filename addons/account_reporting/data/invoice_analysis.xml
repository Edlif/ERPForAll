<!-- Amounts are journal item balances, so every figure is in the company currency. -->
<erp>
  <data noupdate="1">
    <record id="report_invoice_analysis" model="reporting.report">
      <field name="name">Invoice Analysis</field>
      <field name="multi_company" eval="False"/>
      <field name="totals_below" eval="True"/>
    </record>
    <record id="inv_an_col_untaxed" model="reporting.report.column">
      <field name="report_id" ref="report_invoice_analysis"/>
      <field name="sequence">10</field>
      <field name="name">Untaxed</field>
      <field name="label">untaxed</field>
      <field name="kind">monetary</field>
      <field name="sortable" eval="True"/>
    </record>
    <record id="inv_an_col_tax" model="reporting.report.column">
      <field name="report_id" ref="report_invoice_analysis"/>
      <field name="sequence">20</field>
      <field name="name">Tax</field>
      <field name="label">tax</field>
      <field name="kind">monetary</field>
    </record>
    <record id="inv_an_col_total" model="reporting.report.column">
      <field name="report_id" ref="report_invoice_analysis"/>
      <field name="sequence">30</field>
      <field name="name">Total</field>
      <field name="label">total</field>
      <field name="kind">monetary</field>
      <field name="sortable" eval="True"/>
    </record>
    <record id="inv_an_out_inv" model="reporting.report.line">
      <field name="report_id" ref="report_invoice_analysis"/>
      <field name="sequence">10</field>
      <field name="name">Customer Invoices</field>
      <field name="code">OUT_INV</field>
    </record>
    <record id="inv_an_out_inv_u" model="reporting.report.expression"><field name="line_id" ref="inv_an_out_inv"/><field name="label">untaxed</field><field name="engine">formula</field><field name="formula">OUT_INV_BASE.untaxed</field></record>
    <record id="inv_an_out_inv_t" model="reporting.report.expression"><field name="line_id" ref="inv_an_out_inv"/><field name="label">tax</field><field name="engine">formula</field><field name="formula">OUT_INV_TAX.tax</field></record>
    <record id="inv_an_out_inv_tot" model="reporting.report.expression"><field name="line_id" ref="inv_an_out_inv"/><field name="label">total</field><field name="engine">formula</field><field name="formula">untaxed + tax</field></record>
    <record id="inv_an_out_inv_base" model="reporting.report.line">
      <field name="report_id" ref="report_invoice_analysis"/>
      <field name="parent_id" ref="inv_an_out_inv"/>
      <field name="sequence">11</field>
      <field name="name">Untaxed Amount</field>
      <field name="code">OUT_INV_BASE</field>
      <field name="groupby">partner_id,journal_id</field>
    </record>
    <record id="inv_an_out_inv_base_booked" model="reporting.report.expression"><field name="line_id" ref="inv_an_out_inv_base"/><field name="label">booked</field><field name="model">account.move.line</field><field name="field">balance</field><field name="date_field">date</field><field name="domain">[["parent_state","=","posted"],["move_id.move_type","=","out_invoice"],["display_type","=","product"]]</field></record>
    <record id="inv_an_out_inv_base_untaxed" model="reporting.report.expression"><field name="line_id" ref="inv_an_out_inv_base"/><field name="label">untaxed</field><field name="engine">formula</field><field name="formula">0 - booked</field></record>
    <record id="inv_an_out_inv_tax" model="reporting.report.line">
      <field name="report_id" ref="report_invoice_analysis"/>
      <field name="parent_id" ref="inv_an_out_inv"/>
      <field name="sequence">12</field>
      <field name="name">Taxes</field>
      <field name="code">OUT_INV_TAX</field>
      <field name="groupby">partner_id,journal_id</field>
    </record>
    <record id="inv_an_out_inv_tax_booked" model="reporting.report.expression"><field name="line_id" ref="inv_an_out_inv_tax"/><field name="label">booked</field><field name="model">account.move.line</field><field name="field">balance</field><field name="date_field">date</field><field name="domain">[["parent_state","=","posted"],["move_id.move_type","=","out_invoice"],["display_type","=","tax"]]</field></record>
    <record id="inv_an_out_inv_tax_tax" model="reporting.report.expression"><field name="line_id" ref="inv_an_out_inv_tax"/><field name="label">tax</field><field name="engine">formula</field><field name="formula">0 - booked</field></record>

    <record id="inv_an_out_ref" model="reporting.report.line">
      <field name="report_id" ref="report_invoice_analysis"/>
      <field name="sequence">20</field>
      <field name="name">Customer Credit Notes</field>
      <field name="code">OUT_REF</field>
    </record>
    <record id="inv_an_out_ref_u" model="reporting.report.expression"><field name="line_id" ref="inv_an_out_ref"/><field name="label">untaxed</field><field name="engine">formula</field><field name="formula">OUT_REF_BASE.untaxed</field></record>
    <record id="inv_an_out_ref_t" model="reporting.report.expression"><field name="line_id" ref="inv_an_out_ref"/><field name="label">tax</field><field name="engine">formula</field><field name="formula">OUT_REF_TAX.tax</field></record>
    <record id="inv_an_out_ref_tot" model="reporting.report.expression"><field name="line_id" ref="inv_an_out_ref"/><field name="label">total</field><field name="engine">formula</field><field name="formula">untaxed + tax</field></record>
    <record id="inv_an_out_ref_base" model="reporting.report.line">
      <field name="report_id" ref="report_invoice_analysis"/>
      <field name="parent_id" ref="inv_an_out_ref"/>
      <field name="sequence">21</field>
      <field name="name">Untaxed Amount</field>
      <field name="code">OUT_REF_BASE</field>
      <field name="groupby">partner_id,journal_id</field>
    </record>
    <record id="inv_an_out_ref_base_untaxed" model="reporting.report.expression"><field name="line_id" ref="inv_an_out_ref_base"/><field name="label">untaxed</field><field name="model">account.move.line</field><field name="field">balance</field><field name="date_field">date</field><field name="domain">[["parent_state","=","posted"],["move_id.move_type","=","out_refund"],["display_type","=","product"]]</field></record>
    <record id="inv_an_out_ref_tax" model="reporting.report.line">
      <field name="report_id" ref="report_invoice_analysis"/>
      <field name="parent_id" ref="inv_an_out_ref"/>
      <field name="sequence">22</field>
      <field name="name">Taxes</field>
      <field name="code">OUT_REF_TAX</field>
      <field name="groupby">partner_id,journal_id</field>
    </record>
    <record id="inv_an_out_ref_tax_tax" model="reporting.report.expression"><field name="line_id" ref="inv_an_out_ref_tax"/><field name="label">tax</field><field name="model">account.move.line</field><field name="field">balance</field><field name="date_field">date</field><field name="domain">[["parent_state","=","posted"],["move_id.move_type","=","out_refund"],["display_type","=","tax"]]</field></record>

    <record id="inv_an_in_inv" model="reporting.report.line">
      <field name="report_id" ref="report_invoice_analysis"/>
      <field name="sequence">30</field>
      <field name="name">Vendor Bills</field>
      <field name="code">IN_INV</field>
    </record>
    <record id="inv_an_in_inv_u" model="reporting.report.expression"><field name="line_id" ref="inv_an_in_inv"/><field name="label">untaxed</field><field name="engine">formula</field><field name="formula">IN_INV_BASE.untaxed</field></record>
    <record id="inv_an_in_inv_t" model="reporting.report.expression"><field name="line_id" ref="inv_an_in_inv"/><field name="label">tax</field><field name="engine">formula</field><field name="formula">IN_INV_TAX.tax</field></record>
    <record id="inv_an_in_inv_tot" model="reporting.report.expression"><field name="line_id" ref="inv_an_in_inv"/><field name="label">total</field><field name="engine">formula</field><field name="formula">untaxed + tax</field></record>
    <record id="inv_an_in_inv_base" model="reporting.report.line">
      <field name="report_id" ref="report_invoice_analysis"/>
      <field name="parent_id" ref="inv_an_in_inv"/>
      <field name="sequence">31</field>
      <field name="name">Untaxed Amount</field>
      <field name="code">IN_INV_BASE</field>
      <field name="groupby">partner_id,journal_id</field>
    </record>
    <record id="inv_an_in_inv_base_untaxed" model="reporting.report.expression"><field name="line_id" ref="inv_an_in_inv_base"/><field name="label">untaxed</field><field name="model">account.move.line</field><field name="field">balance</field><field name="date_field">date</field><field name="domain">[["parent_state","=","posted"],["move_id.move_type","=","in_invoice"],["display_type","=","product"]]</field></record>
    <record id="inv_an_in_inv_tax" model="reporting.report.line">
      <field name="report_id" ref="report_invoice_analysis"/>
      <field name="parent_id" ref="inv_an_in_inv"/>
      <field name="sequence">32</field>
      <field name="name">Taxes</field>
      <field name="code">IN_INV_TAX</field>
      <field name="groupby">partner_id,journal_id</field>
    </record>
    <record id="inv_an_in_inv_tax_tax" model="reporting.report.expression"><field name="line_id" ref="inv_an_in_inv_tax"/><field name="label">tax</field><field name="model">account.move.line</field><field name="field">balance</field><field name="date_field">date</field><field name="domain">[["parent_state","=","posted"],["move_id.move_type","=","in_invoice"],["display_type","=","tax"]]</field></record>

    <record id="inv_an_in_ref" model="reporting.report.line">
      <field name="report_id" ref="report_invoice_analysis"/>
      <field name="sequence">40</field>
      <field name="name">Vendor Credit Notes</field>
      <field name="code">IN_REF</field>
    </record>
    <record id="inv_an_in_ref_u" model="reporting.report.expression"><field name="line_id" ref="inv_an_in_ref"/><field name="label">untaxed</field><field name="engine">formula</field><field name="formula">IN_REF_BASE.untaxed</field></record>
    <record id="inv_an_in_ref_t" model="reporting.report.expression"><field name="line_id" ref="inv_an_in_ref"/><field name="label">tax</field><field name="engine">formula</field><field name="formula">IN_REF_TAX.tax</field></record>
    <record id="inv_an_in_ref_tot" model="reporting.report.expression"><field name="line_id" ref="inv_an_in_ref"/><field name="label">total</field><field name="engine">formula</field><field name="formula">untaxed + tax</field></record>
    <record id="inv_an_in_ref_base" model="reporting.report.line">
      <field name="report_id" ref="report_invoice_analysis"/>
      <field name="parent_id" ref="inv_an_in_ref"/>
      <field name="sequence">41</field>
      <field name="name">Untaxed Amount</field>
      <field name="code">IN_REF_BASE</field>
