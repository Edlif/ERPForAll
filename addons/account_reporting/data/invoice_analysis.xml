    <record id="inv_an_in_ref_base_booked" model="reporting.report.expression"><field name="line_id" ref="inv_an_in_ref_base"/><field name="label">booked</field><field name="model">account.move.line</field><field name="field">balance</field><field name="date_field">date</field><field name="domain">[["parent_state","=","posted"],["move_id.move_type","=","in_refund"],["display_type","=","product"]]</field></record>
    <record id="inv_an_in_ref_base_untaxed" model="reporting.report.expression"><field name="line_id" ref="inv_an_in_ref_base"/><field name="label">untaxed</field><field name="engine">formula</field><field name="formula">0 - booked</field></record>
    <record id="inv_an_in_ref_tax" model="reporting.report.line">
      <field name="report_id" ref="report_invoice_analysis"/>
      <field name="parent_id" ref="inv_an_in_ref"/>
      <field name="sequence">42</field>
      <field name="name">Taxes</field>
      <field name="code">IN_REF_TAX</field>
      <field name="groupby">partner_id,journal_id</field>
    </record>
    <record id="inv_an_in_ref_tax_booked" model="reporting.report.expression"><field name="line_id" ref="inv_an_in_ref_tax"/><field name="label">booked</field><field name="model">account.move.line</field><field name="field">balance</field><field name="date_field">date</field><field name="domain">[["parent_state","=","posted"],["move_id.move_type","=","in_refund"],["display_type","=","tax"]]</field></record>
    <record id="inv_an_in_ref_tax_tax" model="reporting.report.expression"><field name="line_id" ref="inv_an_in_ref_tax"/><field name="label">tax</field><field name="engine">formula</field><field name="formula">0 - booked</field></record>
  </data>
  <record id="action_invoice_analysis" model="ir.actions.client">
    <field name="name">Invoice Analysis</field>
    <field name="tag">reporting.report</field>
    <field name="params" eval="{'report': ref('report_invoice_analysis')}"/>
  </record>
  <menuitem id="menu_invoice_analysis" name="Invoice Analysis" parent="menu_account_reporting" action="action_invoice_analysis" groups="account.group_account_readonly" sequence="55"/>
  <record id="menu_invoice_analysis" model="ir.ui.menu"><field name="web_icon">lucide:trending-up</field></record>
</erp>
