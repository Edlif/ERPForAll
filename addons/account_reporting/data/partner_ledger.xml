<erp>
    <data noupdate="1">
        <record id="report_partner_ledger" model="reporting.report">
            <field name="name">Partner Ledger</field>
            <field name="provider">account_reporting.partner_ledger</field>
            <field name="date_mode">range</field>
            <field name="date_default">this_year</field>
            <field name="multi_company" eval="False"/>
            <field name="comparison" eval="False"/>
            <field name="totals_below" eval="True"/>
            <field name="unfold_all" eval="True"/>
            <field name="search_bar" eval="True"/>
            <field name="hide_zero">optional</field>
        </record>
        <record id="partner_ledger_column_journal" model="reporting.report.column">
            <field name="report_id" ref="report_partner_ledger"/>
            <field name="sequence">10</field>
            <field name="name">Journal</field>
            <field name="label">journal</field>
            <field name="kind">text</field>
        </record>
        <record id="partner_ledger_column_account" model="reporting.report.column">
            <field name="report_id" ref="report_partner_ledger"/>
            <field name="sequence">20</field>
            <field name="name">Account</field>
            <field name="label">account</field>
            <field name="kind">text</field>
        </record>
        <record id="partner_ledger_column_date" model="reporting.report.column">
            <field name="report_id" ref="report_partner_ledger"/>
            <field name="sequence">30</field>
            <field name="name">Date</field>
            <field name="label">date</field>
            <field name="kind">date</field>
        </record>
        <record id="partner_ledger_column_due_date" model="reporting.report.column">
            <field name="report_id" ref="report_partner_ledger"/>
            <field name="sequence">40</field>
            <field name="name">Due Date</field>
            <field name="label">due_date</field>
            <field name="kind">date</field>
        </record>
        <record id="partner_ledger_column_matching" model="reporting.report.column">
            <field name="report_id" ref="report_partner_ledger"/>
            <field name="sequence">50</field>
            <field name="name">Matching</field>
            <field name="label">matching</field>
            <field name="kind">text</field>
        </record>
        <record id="partner_ledger_column_debit" model="reporting.report.column">
            <field name="report_id" ref="report_partner_ledger"/>
            <field name="sequence">60</field>
            <field name="name">Debit</field>
            <field name="label">debit</field>
            <field name="kind">monetary</field>
            <field name="blank_if_zero" eval="True"/>
        </record>
        <record id="partner_ledger_column_credit" model="reporting.report.column">
            <field name="report_id" ref="report_partner_ledger"/>
            <field name="sequence">70</field>
            <field name="name">Credit</field>
            <field name="label">credit</field>
            <field name="kind">monetary</field>
            <field name="blank_if_zero" eval="True"/>
        </record>
        <record id="partner_ledger_column_balance" model="reporting.report.column">
            <field name="report_id" ref="report_partner_ledger"/>
            <field name="sequence">80</field>
            <field name="name">Balance</field>
            <field name="label">balance</field>
            <field name="kind">monetary</field>
        </record>
    </data>
    <record id="action_partner_ledger" model="ir.actions.client">
        <field name="name">Partner Ledger</field>
        <field name="tag">reporting.report</field>
        <field name="params" eval="{'report': ref('report_partner_ledger')}"/>
    </record>
    <menuitem id="menu_partner_ledger" name="Partner Ledger" parent="menu_account_reporting" action="action_partner_ledger" groups="account.group_account_readonly" sequence="40"/>
    <record id="menu_partner_ledger" model="ir.ui.menu"><field name="web_icon">lucide:contact</field></record>
</erp>
