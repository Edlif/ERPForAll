<erp>
    <data noupdate="1">
        <record id="report_account_movements" model="reporting.report">
            <field name="name">Account Movements</field>
            <field name="multi_company" eval="False"/>
        </record>
        <record id="movements_by_account" model="reporting.report.line">
            <field name="report_id" ref="report_account_movements"/>
            <field name="name">Period movements</field>
            <field name="code">MOVEMENTS</field>
            <field name="groupby">account_id,move_id</field>
        </record>
        <record id="movements_column_debit" model="reporting.report.column">
            <field name="report_id" ref="report_account_movements"/>
            <field name="sequence">10</field>
            <field name="name">Debit</field>
            <field name="label">debit</field>
            <field name="kind">monetary</field>
            <field name="sortable" eval="True"/>
        </record>
        <record id="movements_expression_debit" model="reporting.report.expression">
            <field name="line_id" ref="movements_by_account"/>
            <field name="label">debit</field>
            <field name="model">account.move.line</field>
            <field name="field">debit</field>
            <field name="date_field">date</field>
            <field name="domain">[["parent_state","=","posted"],["account_id","!=",false],["journal_id.journal_group_id","=",false]]</field>
        </record>
        <record id="movements_column_credit" model="reporting.report.column">
            <field name="report_id" ref="report_account_movements"/>
            <field name="sequence">20</field>
            <field name="name">Credit</field>
            <field name="label">credit</field>
            <field name="kind">monetary</field>
            <field name="sortable" eval="True"/>
        </record>
        <record id="movements_expression_credit" model="reporting.report.expression">
            <field name="line_id" ref="movements_by_account"/>
            <field name="label">credit</field>
            <field name="model">account.move.line</field>
            <field name="field">credit</field>
            <field name="date_field">date</field>
            <field name="domain">[["parent_state","=","posted"],["account_id","!=",false],["journal_id.journal_group_id","=",false]]</field>
        </record>
        <record id="movements_column_net" model="reporting.report.column">
            <field name="report_id" ref="report_account_movements"/>
            <field name="sequence">30</field>
            <field name="name">Net change</field>
            <field name="label">net</field>
            <field name="kind">monetary</field>
            <field name="sortable" eval="True"/>
        </record>
        <record id="movements_expression_net" model="reporting.report.expression">
            <field name="line_id" ref="movements_by_account"/>
            <field name="label">net</field>
            <field name="model">account.move.line</field>
            <field name="field">balance</field>
            <field name="date_field">date</field>
            <field name="domain">[["parent_state","=","posted"],["account_id","!=",false],["journal_id.journal_group_id","=",false]]</field>
        </record>
    </data>
    <record id="action_account_movements" model="ir.actions.client">
        <field name="name">Account Movements</field>
        <field name="tag">reporting.report</field>
        <field name="params" eval="{'report': ref('report_account_movements')}"/>
    </record>
    <menuitem id="menu_account_movements" name="Account Movements" parent="menu_account_reporting" action="action_account_movements" groups="account.group_account_readonly" sequence="20"/>
    <record id="menu_account_movements" model="ir.ui.menu"><field name="web_icon">lucide:list</field></record>
</erp>
