<erp>
  <data noupdate="1">
    <record id="report_aged_payable" model="reporting.report">
      <field name="name">Aged Payable</field>
      <field name="provider">account_reporting.aged_payable</field>
      <field name="date_mode">single</field>
      <field name="date_default">today</field>
      <field name="comparison" eval="False"/>
      <field name="multi_company" eval="False"/>
      <field name="totals_below" eval="True"/>
    </record>
    <record id="aged_ap_col_due" model="reporting.report.column"><field name="report_id" ref="report_aged_payable"/><field name="sequence">5</field><field name="name">Due Date</field><field name="label">due_date</field><field name="kind">date</field></record>
    <record id="aged_ap_col_0" model="reporting.report.column"><field name="report_id" ref="report_aged_payable"/><field name="sequence">10</field><field name="name">At Date</field><field name="label">not_due</field><field name="kind">monetary</field></record>
    <record id="aged_ap_col_1" model="reporting.report.column"><field name="report_id" ref="report_aged_payable"/><field name="sequence">20</field><field name="name">1 - 30</field><field name="label">d1_30</field><field name="kind">monetary</field></record>
    <record id="aged_ap_col_2" model="reporting.report.column"><field name="report_id" ref="report_aged_payable"/><field name="sequence">30</field><field name="name">31 - 60</field><field name="label">d31_60</field><field name="kind">monetary</field></record>
    <record id="aged_ap_col_3" model="reporting.report.column"><field name="report_id" ref="report_aged_payable"/><field name="sequence">40</field><field name="name">61 - 90</field><field name="label">d61_90</field><field name="kind">monetary</field></record>
    <record id="aged_ap_col_4" model="reporting.report.column"><field name="report_id" ref="report_aged_payable"/><field name="sequence">50</field><field name="name">91 - 120</field><field name="label">d91_120</field><field name="kind">monetary</field></record>
    <record id="aged_ap_col_5" model="reporting.report.column"><field name="report_id" ref="report_aged_payable"/><field name="sequence">60</field><field name="name">Older</field><field name="label">older</field><field name="kind">monetary</field></record>
    <record id="aged_ap_col_6" model="reporting.report.column"><field name="report_id" ref="report_aged_payable"/><field name="sequence">70</field><field name="name">Total</field><field name="label">total</field><field name="kind">monetary</field></record>
  </data>
  <record id="action_aged_payable" model="ir.actions.client">
    <field name="name">Aged Payable</field>
    <field name="tag">reporting.report</field>
    <field name="params" eval="{'report': ref('report_aged_payable')}"/>
  </record>
  <menuitem id="menu_aged_payable" name="Aged Payable" parent="menu_account_reporting" action="action_aged_payable" groups="account.group_account_readonly" sequence="44"/>
  <record id="menu_aged_payable" model="ir.ui.menu"><field name="web_icon">lucide:calendar-days</field></record>
</erp>
