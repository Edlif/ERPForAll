<erp>
  <record id="product_template_form_purchase_warnings" model="ir.ui.view">
    <field name="name">product.template.form.purchase.warnings</field>
    <field name="model">product.template</field>
    <field name="inherit_id" ref="product.product_template_form_view"/>
    <field name="arch" type="xml">
      <xpath expr="//page[@name='general_information']" position="inside">
        <group name="purchase_warnings" string="Warning on Purchase Orders" groups="purchase.group_warning_purchase">
          <field name="purchase_line_warn_msg" placeholder="e.g. Verify specification before ordering."/>
        </group>
      </xpath>
    </field>
  </record>
</erp>
