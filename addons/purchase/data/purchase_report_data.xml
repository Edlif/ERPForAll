<!-- Dynamic Purchase Reports built on the shared `reporting.report` screen -->
<erp>
  <data noupdate="1">
    <record id="report_purchase_ledger" model="reporting.report">
      <field name="name">Purchase Report</field>
      <field name="provider">purchase.purchase_report</field>
      <field name="date_mode">range</field>
      <field name="date_default">this_year</field>
      <field name="comparison" eval="False"/>
      <field name="multi_company" eval="False"/>
      <field name="unfold_all" eval="True"/>
      <field name="hide_zero">optional</field>
      <field name="search_bar" eval="True"/>
      <field name="totals_below" eval="True"/>
    </record>
    <record id="pur_rep_col_date" model="reporting.report.column"><field name="report_id" ref="report_purchase_ledger"/><field name="sequence">10</field><field name="name">Order Date</field><field name="label">date_order</field><field name="kind">date</field></record>
    <record id="pur_rep_col_planned" model="reporting.report.column"><field name="report_id" ref="report_purchase_ledger"/><field name="sequence">20</field><field name="name">Expected Arrival</field><field name="label">date_planned</field><field name="kind">date</field></record>
    <record id="pur_rep_col_ordered" model="reporting.report.column"><field name="report_id" ref="report_purchase_ledger"/><field name="sequence">30</field><field name="name">Ordered</field><field name="label">ordered</field><field name="kind">decimal</field></record>
    <record id="pur_rep_col_received" model="reporting.report.column"><field name="report_id" ref="report_purchase_ledger"/><field name="sequence">40</field><field name="name">Received</field><field name="label">received</field><field name="kind">decimal</field></record>
    <record id="pur_rep_col_billed" model="reporting.report.column"><field name="report_id" ref="report_purchase_ledger"/><field name="sequence">50</field><field name="name">Billed</field><field name="label">billed</field><field name="kind">decimal</field></record>
    <record id="pur_rep_col_untaxed" model="reporting.report.column"><field name="report_id" ref="report_purchase_ledger"/><field name="sequence">60</field><field name="name">Untaxed</field><field name="label">untaxed</field><field name="kind">monetary</field></record>
    <record id="pur_rep_col_total" model="reporting.report.column"><field name="report_id" ref="report_purchase_ledger"/><field name="sequence">70</field><field name="name">Total</field><field name="label">total</field><field name="kind">monetary</field></record>

    <record id="report_purchase_by_product" model="reporting.report">
      <field name="name">Purchases by Product</field>
      <field name="date_mode">range</field>
      <field name="date_default">this_year</field>
      <field name="comparison" eval="True"/>
      <field name="multi_company" eval="False"/>
      <field name="unfold_all" eval="True"/>
      <field name="hide_zero">optional</field>
      <field name="search_bar" eval="True"/>
      <field name="totals_below" eval="True"/>
    </record>
    <record id="pur_prod_col_ordered" model="reporting.report.column"><field name="report_id" ref="report_purchase_by_product"/><field name="sequence">10</field><field name="name">Ordered</field><field name="label">ordered</field><field name="kind">decimal</field><field name="sortable" eval="True"/></record>
    <record id="pur_prod_col_received" model="reporting.report.column"><field name="report_id" ref="report_purchase_by_product"/><field name="sequence">20</field><field name="name">Received</field><field name="label">received</field><field name="kind">decimal</field><field name="sortable" eval="True"/></record>
    <record id="pur_prod_col_billed" model="reporting.report.column"><field name="report_id" ref="report_purchase_by_product"/><field name="sequence">30</field><field name="name">Billed</field><field name="label">billed</field><field name="kind">decimal</field><field name="sortable" eval="True"/></record>
    <record id="pur_prod_col_untaxed" model="reporting.report.column"><field name="report_id" ref="report_purchase_by_product"/><field name="sequence">40</field><field name="name">Untaxed</field><field name="label">untaxed</field><field name="kind">monetary</field><field name="sortable" eval="True"/></record>

    <record id="pur_prod_line_all" model="reporting.report.line">
      <field name="report_id" ref="report_purchase_by_product"/>
      <field name="sequence">10</field>
      <field name="name">Purchased Products</field>
      <field name="code">PRODUCTS</field>
      <field name="groupby">product_id,partner_id</field>
    </record>
    <record id="pur_prod_ord" model="reporting.report.expression"><field name="line_id" ref="pur_prod_line_all"/><field name="label">ordered</field><field name="model">purchase.order.line</field><field name="field">product_qty</field><field name="date_field">create_date</field><field name="domain">[["product_id","!=",false]]</field></record>
    <record id="pur_prod_rec" model="reporting.report.expression"><field name="line_id" ref="pur_prod_line_all"/><field name="label">received</field><field name="model">purchase.order.line</field><field name="field">qty_received</field><field name="date_field">create_date</field><field name="domain">[["product_id","!=",false]]</field></record>
    <record id="pur_prod_bil" model="reporting.report.expression"><field name="line_id" ref="pur_prod_line_all"/><field name="label">billed</field><field name="model">purchase.order.line</field><field name="field">qty_invoiced</field><field name="date_field">create_date</field><field name="domain">[["product_id","!=",false]]</field></record>
    <record id="pur_prod_unt" model="reporting.report.expression"><field name="line_id" ref="pur_prod_line_all"/><field name="label">untaxed</field><field name="model">purchase.order.line</field><field name="field">price_subtotal</field><field name="date_field">create_date</field><field name="domain">[["product_id","!=",false]]</field></record>
  </data>

  <record id="action_purchase_dynamic_report" model="ir.actions.client">
    <field name="name">Purchase Report</field>
    <field name="tag">reporting.report</field>
    <field name="params" eval="{'report': ref('report_purchase_ledger')}"/>
  </record>
  <record id="action_purchase_by_product_report" model="ir.actions.client">
    <field name="name">Purchases by Product</field>
    <field name="tag">reporting.report</field>
    <field name="params" eval="{'report': ref('report_purchase_by_product')}"/>
  </record>
</erp>
