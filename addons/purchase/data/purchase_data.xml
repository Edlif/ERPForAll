<!--
Default data of purchase orders: the order numbering, one sequence shared by
     every company. A company that wants its own numbering adds a sequence with the same code and its
     company. Orders themselves ship no default records, as in the reference. 
-->
<erp>
  <data noupdate="1">
    <record id="seq_purchase_order" model="ir.sequence">
      <field name="name">Purchase Order</field>
      <field name="code">purchase.order</field>
      <field name="prefix">PO</field>
      <field name="padding">5</field>
      <field name="number_next">1</field>
      <field name="number_increment">1</field>
      <field name="company_id" eval="False"/>
    </record>
    <record id="seq_purchase_requisition" model="ir.sequence">
      <field name="name">Purchase Agreement</field>
      <field name="code">purchase.requisition</field>
      <field name="prefix">PA</field>
      <field name="padding">5</field>
      <field name="number_next">1</field>
      <field name="number_increment">1</field>
      <field name="company_id" eval="False"/>
    </record>
  </data>
</erp>
