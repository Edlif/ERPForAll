<!--
The Purchase privilege and its two roles. The feature groups of
     warnings and receipt reminders come with the slices that use them. 
-->
<erp noupdate="1">
  <record id="res_groups_privilege_purchase" model="res.groups.privilege">
    <field name="name">Purchase</field>
    <field name="description">Control who may request quotations, order from vendors and approve orders.</field>
    <field name="placeholder">No purchase role</field>
    <field name="sequence">8</field>
  </record>
  <record id="group_purchase_user" model="res.groups">
    <field name="name">User</field>
    <field name="sequence">10</field>
    <field name="privilege_id" ref="res_groups_privilege_purchase"/>
    <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
  </record>
  <record id="group_purchase_manager" model="res.groups">
    <field name="name">Administrator</field>
    <field name="sequence">20</field>
    <field name="privilege_id" ref="res_groups_privilege_purchase"/>
    <field name="implied_ids" eval="[Command.link(ref('purchase.group_purchase_user'))]"/>
    <field name="implied_by_ids" eval="[Command.link(ref('base.group_system'))]"/>
  </record>
</erp>
