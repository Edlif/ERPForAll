<erp>
  <record id="hr_job_view_search" model="ir.ui.view">
    <field name="name">hr.job.search</field>
    <field name="model">hr.job</field>
    <field name="arch" type="xml">
      <search string="Search Job Positions">
        <field name="name"/>
        <field name="department_id"/>
        <field name="employee_type_id"/>
        <group string="Group By">
          <filter name="group_department" string="Department" context="{'group_by': 'department_id'}"/>
          <filter name="group_company" string="Company" context="{'group_by': 'company_id'}"/>
          <filter name="group_employee_type" string="Employment Type" context="{'group_by': 'employee_type_id'}"/>
        </group>
      </search>
    </field>
  </record>

  <record id="hr_job_view_list" model="ir.ui.view">
    <field name="name">hr.job.list</field>
    <field name="model">hr.job</field>
    <field name="arch" type="xml">
      <list string="Job Positions">
        <field name="sequence"/>
        <field name="name"/>
        <field name="department_id"/>
        <field name="no_of_employee"/>
        <field name="no_of_recruitment"/>
        <field name="expected_employees"/>
        <field name="employee_type_id"/>
        <field name="company_id"/>
      </list>
    </field>
  </record>

  <record id="hr_job_view_kanban" model="ir.ui.view">
    <field name="name">hr.job.kanban</field>
    <field name="model">hr.job</field>
    <field name="arch" type="xml">
      <kanban string="Job Positions">
        <templates>
          <t t-name="card">
            <main>
              <field name="name"/>
              <field name="department_id"/>
              <field name="employee_type_id"/>
            </main>
            <footer>
              <field name="no_of_employee"/>
              <field name="no_of_recruitment"/>
            </footer>
          </t>
        </templates>
      </kanban>
    </field>
  </record>

  <record id="hr_job_view_form" model="ir.ui.view">
    <field name="name">hr.job.form</field>
    <field name="model">hr.job</field>
    <field name="arch" type="xml">
      <form string="Job Position">
        <sheet>
          <div class="oe_button_box" name="button_box">
            <button name="action_open_employees" type="object" class="oe_stat_button" icon="lucide:users">
              <field name="no_of_employee" widget="statinfo" string="Employees"/>
            </button>
          </div>
          <widget name="web_ribbon" title="Archived" bg_color="bg-danger" invisible="active"/>
          <div class="oe_title">
            <h1><field name="name" placeholder="e.g. Senior Rust Engineer"/></h1>
          </div>
          <notebook>
            <page string="Recruitment">
              <group>
                <group>
                  <field name="department_id"/>
                  <field name="employee_type_id"/>
                  <field name="company_id"/>
                </group>
                <group>
                  <field name="recruiter_id"/>
                  <field name="no_of_recruitment"/>
                  <field name="expected_employees" readonly="1"/>
                  <field name="sequence"/>
                  <field name="active"/>
                </group>
              </group>
            </page>
            <page string="Job Summary">
              <field name="description"/>
            </page>
          </notebook>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>

  <record id="hr_job_action" model="ir.actions.act_window">
    <field name="name">Job Positions</field>
    <field name="res_model">hr.job</field>
    <field name="view_mode">list,kanban,form</field>
  </record>
</erp>
