<erp noupdate="1">
  <record id="res_groups_privilege_employees" model="res.groups.privilege">
    <field name="name">Employees</field>
    <field name="description">Manage employee records, departments, contracts, resume entries and skills.</field>
    <field name="placeholder">No HR role</field>
    <field name="sequence">30</field>
  </record>

  <record id="group_hr_user" model="res.groups">
    <field name="name">Officer</field>
    <field name="sequence">10</field>
    <field name="privilege_id" ref="res_groups_privilege_employees"/>
    <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
  </record>

  <record id="group_hr_manager" model="res.groups">
    <field name="name">Administrator</field>
    <field name="sequence">20</field>
    <field name="privilege_id" ref="res_groups_privilege_employees"/>
    <field name="implied_ids" eval="[Command.link(ref('hr.group_hr_user'))]"/>
    <field name="implied_by_ids" eval="[Command.link(ref('base.group_system'))]"/>
  </record>
</erp>
