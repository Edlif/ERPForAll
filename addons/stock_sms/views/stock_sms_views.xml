<erp>
  <record id="view_stock_delivery_notification_list" model="ir.ui.view">
    <field name="name">stock.delivery.notification.list</field>
    <field name="model">stock.delivery.notification</field>
    <field name="arch" type="xml">
      <list string="Delivery Notifications">
        <field name="sent_at"/>
        <field name="picking_id"/>
        <field name="partner_id"/>
        <field name="channel" widget="badge" options="{'tone_info': ['email'], 'tone_success': ['sms']}"/>
        <field name="recipient"/>
        <field name="state" widget="badge" options="{'tone_success': ['sent'], 'tone_warning': ['skipped']}"/>
      </list>
    </field>
  </record>

  <record id="view_stock_delivery_notification_form" model="ir.ui.view">
    <field name="name">stock.delivery.notification.form</field>
    <field name="model">stock.delivery.notification</field>
    <field name="arch" type="xml">
      <form string="Delivery Notification">
        <sheet>
          <group>
            <group>
              <field name="picking_id" readonly="1"/>
              <field name="partner_id" readonly="1"/>
              <field name="company_id" readonly="1"/>
            </group>
            <group>
              <field name="channel" readonly="1"/>
              <field name="recipient" readonly="1"/>
              <field name="sent_at" readonly="1"/>
              <field name="state" readonly="1"/>
            </group>
          </group>
          <group string="Message">
            <field name="message" readonly="1"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="view_stock_delivery_notification_search" model="ir.ui.view">
    <field name="name">stock.delivery.notification.search</field>
    <field name="model">stock.delivery.notification</field>
    <field name="arch" type="xml">
      <search string="Delivery Notifications">
        <field name="picking_id"/>
        <field name="partner_id"/>
        <field name="recipient"/>
        <filter name="filter_email" string="Email" domain="[('channel', '=', 'email')]"/>
        <filter name="filter_sms" string="SMS" domain="[('channel', '=', 'sms')]"/>
        <group>
          <filter name="group_channel" string="Channel" context="{'group_by': 'channel'}"/>
          <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
        </group>
      </search>
    </field>
  </record>

  <record id="action_stock_delivery_notification" model="ir.actions.act_window">
    <field name="name">Delivery Notifications</field>
    <field name="res_model">stock.delivery.notification</field>
    <field name="view_mode">list,form</field>
    <field name="target">current</field>
    <field name="search_view_id" ref="view_stock_delivery_notification_search"/>
  </record>

  <menuitem id="menu_stock_delivery_notification" name="Delivery Notifications" parent="stock.menu_stock_reporting" action="action_stock_delivery_notification" groups="stock.group_stock_user" sequence="55"/>
  <record id="menu_stock_delivery_notification" model="ir.ui.menu"><field name="web_icon">lucide:inbox</field></record>

  <record id="view_picking_form_sms_button" model="ir.ui.view">
    <field name="name">stock.picking.form.sms.button</field>
    <field name="model">stock.picking</field>
    <field name="inherit_id" ref="stock.view_picking_form"/>
    <field name="arch" type="xml">
      <xpath expr="//div[@name='button_box']" position="inside">
        <button name="action_view_notifications" type="object" class="oe_stat_button" icon="lucide:inbox" invisible="notification_count == 0">
          <field name="notification_count" widget="statinfo" string="Notifications"/>
        </button>
      </xpath>
    </field>
  </record>
</erp>
