<!-- Configuration screens of the CRM: pipeline stages and lost reasons. Tags and sales teams use
     the screens of sales_team. -->
<erp>
  <record id="crm_stage_view_list" model="ir.ui.view">
    <field name="name">crm.stage.list</field>
    <field name="model">crm.stage</field>
    <field name="arch" type="xml">
      <list string="Stages">
        <field name="sequence"/>
        <field name="name"/>
        <field name="team_id"/>
        <field name="is_won"/>
        <field name="fold"/>
      </list>
    </field>
  </record>

  <record id="crm_stage_view_form" model="ir.ui.view">
    <field name="name">crm.stage.form</field>
    <field name="model">crm.stage</field>
    <field name="arch" type="xml">
      <form string="Stage">
        <sheet>
          <div class="oe_title">
            <h1><field name="name" placeholder="e.g. Negotiation"/></h1>
          </div>
          <group>
            <group string="Pipeline">
              <field name="sequence"/>
              <field name="team_id"/>
            </group>
            <group string="Behaviour">
              <field name="is_won"/>
              <field name="fold"/>
            </group>
          </group>
          <notebook>
            <page name="requirements" string="Requirements">
              <field name="requirements"/>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <record id="crm_stage_action" model="ir.actions.act_window">
    <field name="name">Stages</field>
    <field name="res_model">crm.stage</field>
    <field name="view_mode">list,form</field>
    <field name="view_id" ref="crm_stage_view_list"/>
  </record>

  <record id="crm_lost_reason_view_search" model="ir.ui.view">
    <field name="name">crm.lost.reason.search</field>
    <field name="model">crm.lost.reason</field>
    <field name="arch" type="xml">
      <search string="Lost Reasons">
        <field name="name"/>
        <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
      </search>
    </field>
  </record>

  <record id="crm_lost_reason_view_list" model="ir.ui.view">
    <field name="name">crm.lost.reason.list</field>
    <field name="model">crm.lost.reason</field>
    <field name="arch" type="xml">
      <list string="Lost Reasons">
        <field name="name"/>
      </list>
    </field>
  </record>

  <record id="crm_lost_reason_view_form" model="ir.ui.view">
    <field name="name">crm.lost.reason.form</field>
    <field name="model">crm.lost.reason</field>
    <field name="arch" type="xml">
      <form string="Lost Reason">
        <sheet>
          <field name="active" invisible="1"/>
          <widget name="web_ribbon" title="Archived" bg_color="bg-danger" invisible="active"/>
          <group>
            <field name="name"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="crm_lost_reason_action" model="ir.actions.act_window">
    <field name="name">Lost Reasons</field>
    <field name="res_model">crm.lost.reason</field>
    <field name="view_mode">list,form</field>
    <field name="view_id" ref="crm_lost_reason_view_list"/>
    <field name="search_view_id" ref="crm_lost_reason_view_search"/>
  </record>
</erp>
