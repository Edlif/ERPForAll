<!--
The two layouts a printed report calls. Both take the caller's
     body as `0`. `html_container` adds nothing around it; `external_layout` adds the company of the
     printing user at the top of every page and the page counter at the bottom. A report calls a
     layout once around all its records, because a document has one page header and one footer. 
-->
<erp>
    <template id="html_container">
        <t t-out="0"/>
    </template>

    <template id="external_layout">
        <div class="header">
            <div class="row border-bottom pb-2">
                <div class="col">
                    <strong t-field="company.name"/>
                </div>
                <div class="col text-end small text-muted">
                    <div t-if="company.street" t-field="company.street"/>
                    <div t-if="company.zip or company.city">
                        <span t-field="company.zip"/> <span t-field="company.city"/>
                    </div>
                    <div t-if="company.phone" t-field="company.phone"/>
                    <div t-if="company.email" t-field="company.email"/>
                </div>
            </div>
        </div>
        <div class="article">
            <t t-out="0"/>
        </div>
        <div class="footer">
            <div class="text-center small text-muted border-top pt-2">
                Page <span class="page"/> of <span class="topage"/>
            </div>
        </div>
    </template>
</erp>
