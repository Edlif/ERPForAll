<!--
The two layouts a printed report calls. Both take the caller's
     body as `0`. `html_container` adds nothing around it; `external_layout` adds a letterhead (the
     printing user's company: name, address, phone, email, website, tax id) at the top of every page
     and a footer with the company's contact line and the page counter at the bottom. A report calls a
     layout once around all its records, because a document has one page header and one footer. 
-->
<erp>
    <template id="html_container">
        <t t-out="0"/>
    </template>

    <template id="external_layout">
        <div class="header">
            <div class="row border-bottom pb-2">
                <div class="col-6">
                    <div class="fw-bold" style="font-size: 12pt" t-field="company.name"/>
                    <div class="small text-muted" t-if="company.street or company.street2">
                        <span t-if="company.street" t-field="company.street"/><t t-if="company.street and company.street2">, </t><span t-if="company.street2" t-field="company.street2"/>
                    </div>
                    <div class="small text-muted" t-if="company.zip or company.city">
                        <span t-field="company.zip"/> <span t-field="company.city"/>
                    </div>
                </div>
                <div class="col-6 text-end small text-muted">
                    <div t-if="company.phone or company.email"><span t-if="company.phone" t-field="company.phone"/><t t-if="company.phone and company.email"> &#183; </t><span t-if="company.email" t-field="company.email"/></div>
                    <div t-if="company.website" t-field="company.website"/>
                    <div t-if="company.vat">Tax ID <span t-field="company.vat"/></div>
                </div>
            </div>
        </div>
        <div class="article">
            <t t-out="0"/>
        </div>
        <div class="footer">
            <div class="border-top pt-2 small text-muted text-center">
                <div>
                    <span t-field="company.name"/>
                    <t t-if="company.phone"> &#183; <span t-field="company.phone"/></t>
                    <t t-if="company.email"> &#183; <span t-field="company.email"/></t>
                    <t t-if="company.website"> &#183; <span t-field="company.website"/></t>
                </div>
                <div>Page <span class="page"/> / <span class="topage"/></div>
            </div>
        </div>
    </template>
</erp>
